---
import Layout from '../layouts/Layout.astro';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rolfing for Low Back Pain in Folsom",
    "description": "Rolfing Structural Integration in Folsom for recurring low back pain, pelvic and hip strain, sitting and lifting patterns, and whole-body support.",
    "provider": {
      "@id": "https://ryansrolfing.com/#business"
    },
    "areaServed": [
      "Folsom",
      "El Dorado Hills",
      "Shingle Springs",
      "Cameron Park",
      "Placerville",
      "Sacramento"
    ],
    "url": "https://ryansrolfing.com/rolfing-for-back-pain-folsom/",
    "serviceType": "Rolfing Structural Integration"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can Rolfing help low back pain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing may support some people with recurring low back tension by addressing posture, fascia, breath, hip and pelvic support, and how the body shares load. It is not medical treatment and should not replace care for serious symptoms."
        }
      },
      {
        "@type": "Question",
        "name": "Will you only work on my low back?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Usually no. Low back pain often involves the pelvis, hips, legs, feet, ribs, breath, and sometimes the neck. Ryan works with the pattern that is keeping the low back overloaded."
        }
      },
      {
        "@type": "Question",
        "name": "What if the pain runs into my leg?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Pain that travels into the buttock or leg can involve the hips, pelvis, and how the spine is supported. That overlap is described on the sciatica page. Numbness, weakness, or pain after trauma needs medical care first."
        }
      },
      {
        "@type": "Question",
        "name": "When should I see a doctor first?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Seek medical care first for sudden or severe low back pain, trauma, fever, unexplained symptoms, radiating numbness or weakness, changes in bowel or bladder control, or pain that is worsening or concerning."
        }
      }
    ]
  }
];
