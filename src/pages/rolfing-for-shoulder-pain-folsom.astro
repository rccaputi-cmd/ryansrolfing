---
import Layout from '../layouts/Layout.astro';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rolfing for Shoulder Pain in Folsom",
    "description": "Rolfing Structural Integration in Folsom for recurring shoulder strain, shoulder-blade tension, and the neck, rib, and posture patterns that often travel with it.",
    "provider": {
      "@id": "https://ryansrolfing.com/#business"
    },
    "areaServed": [
      "Folsom",
      "El Dorado Hills",
      "Shingle Springs",
      "Cameron Park",
      "Placerville",
      "Sacramento"
    ],
    "url": "https://ryansrolfing.com/rolfing-for-shoulder-pain-folsom/",
    "serviceType": "Rolfing Structural Integration"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can Rolfing help shoulder pain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing may support some people with recurring shoulder strain by working with the shoulder blade, ribs, neck, chest, and the way the arm is carried. It is not medical treatment for tears, dislocation, or joint disease."
        }
      },
      {
        "@type": "Question",
        "name": "Will you only work on the shoulder?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Usually no. Shoulder pain often involves the neck, ribs, chest, upper back, and sometimes the pelvis. Ryan works with the pattern that is keeping the shoulder overloaded."
        }
      },
      {
        "@type": "Question",
        "name": "What if I also have neck pain or jaw tension?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Neck pain, jaw tension, and shoulder strain often travel together. The neck and jaw pages describe that overlap. A session can include more than one of them when they are part of the same pattern."
        }
      },
      {
        "@type": "Question",
        "name": "When should I see a doctor first?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Seek medical care first for sudden shoulder pain after an injury, inability to lift the arm, visible deformity, significant swelling, fever, or numbness and weakness that is new or worsening."
        }
      }
    ]
  }
];
---
<Layout title="Rolfing for Shoulder Pain in Folsom | Ryan’s Rolfing" description="Rolfing Structural Integration in Folsom for recurring shoulder strain, shoulder-blade tension, and the neck, rib, and posture patterns that often travel with it." schema={schema}>
  <nav aria-label="Breadcrumb" class="px-5 pt-8">
