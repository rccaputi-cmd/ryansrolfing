---
import Layout from '../layouts/Layout.astro';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rolfing for Knee Pain in Folsom",
    "description": "Rolfing Structural Integration in Folsom for recurring knee strain related to the foot, hip, pelvis, and how the leg bears weight. Not orthopedic care.",
    "provider": {
      "@id": "https://ryansrolfing.com/#business"
    },
    "areaServed": [
      "Folsom",
      "El Dorado Hills",
      "Shingle Springs",
      "Cameron Park",
      "Placerville",
      "Sacramento"
    ],
    "url": "https://ryansrolfing.com/rolfing-for-knee-pain-folsom/",
    "serviceType": "Rolfing Structural Integration"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can Rolfing help knee pain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing may support some people with recurring knee strain by working with the foot, ankle, hip, pelvis, and the way the leg bears weight. It is not medical treatment for ligament tears, meniscus injury, or arthritis."
        }
      },
      {
        "@type": "Question",
        "name": "Will you only work on my knee?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Usually no. The knee is often caught between the hip and the foot. Sessions follow that relationship rather than treating the knee as an isolated part."
        }
      },
      {
        "@type": "Question",
        "name": "Is this a good idea after surgery?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Only with your surgeon’s clearance, and with a clear conversation about what is still healing. Rolfing is not post-operative rehabilitation."
        }
      },
      {
        "@type": "Question",
        "name": "When should I see a doctor first?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Seek medical care first for a knee that locks, gives way, or swells after an injury, for redness and fever, or for pain that is sudden, severe, or worsening."
        }
      }
    ]
  }
];
