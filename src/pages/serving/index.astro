---
import Layout from '../../layouts/Layout.astro';
import { bookingUrl } from '../../lib/booking';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Rolfing Service Areas near Folsom, CA",
    "description": "Local service area guide for Ryan’s Rolfing in Folsom, El Dorado Hills, Shingle Springs, Cameron Park, Placerville, and Sacramento.",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Rolfing near Folsom",
          "url": "https://ryansrolfing.com/serving/folsom-rolfing/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Rolfing near El Dorado Hills",
          "url": "https://ryansrolfing.com/serving/el-dorado-hills-rolfing/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Rolfing near Shingle Springs",
          "url": "https://ryansrolfing.com/serving/shingle-springs-rolfing/"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Rolfing near Cameron Park",
          "url": "https://ryansrolfing.com/serving/cameron-park-rolfing/"
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Rolfing near Placerville",
          "url": "https://ryansrolfing.com/serving/placerville-rolfing/"
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Rolfing near Sacramento",
          "url": "https://ryansrolfing.com/serving/sacramento-rolfing/"
        }
      ]
    }
  }
];
---
<Layout title="Rolfing Service Areas near Folsom, CA | Ryan’s Rolfing" description="Rolfing and somatic bodywork from Folsom for El Dorado Hills, Shingle Springs, Cameron Park, Placerville, Sacramento, and nearby." schema={schema}>
  <section class="px-5 py-20 md:py-28">
   <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">
     Service areas
    </p>
    <h1 class="mt-5 text-5xl leading-tight md:text-7xl">
     Rolfing Structural Integration near Folsom and El Dorado County.
    </h1>
    <p class="mx-auto mt-7 max-w-3xl text-xl leading-9 text-[#545454]/85">
     Ryan’s office is in Folsom, with clients coming from nearby communities for Rolfing, Somatic Experiencing, NeuroAffective Touch, posture work, chronic-pain bodywork, and whole-body structural support.
    </p>
   </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
   <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
    <a class="block rounded-3xl bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/serving/folsom-rolfing/">
     <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
      Serving Folsom
     </p>
     <h2 class="mt-4 text-4xl leading-tight">
      Rolfing near Folsom
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      Ryan’s Rolfing is based in Folsom, offering Rolfing Structural Integration, Somatic Experiencing, and NeuroAffective Touch for people seeking a deeper approach to pain, posture, stress, and movement.
     </p>
     <p class="mt-6 text-sm uppercase tracking-[0.18em] text-[#c4924a]">
      View local page →
     </p>
    </a>
    <a class="block rounded-3xl bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/serving/el-dorado-hills-rolfing/">
     <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
      Serving El Dorado Hills
     </p>
     <h2 class="mt-4 text-4xl leading-tight">
      Rolfing near El Dorado Hills
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      Ryan’s Folsom office is a short drive from El Dorado Hills for people looking for skilled Rolfing Structural Integration, structural bodywork, and nervous-system-informed care.
     </p>
     <p class="mt-6 text-sm uppercase tracking-[0.18em] text-[#c4924a]">
      View local page →
     </p>
    </a>
    <a class="block rounded-3xl bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/serving/shingle-springs-rolfing/">
     <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
      Serving Shingle Springs
     </p>
     <h2 class="mt-4 text-4xl leading-tight">
      Rolfing near Shingle Springs
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      For people in Shingle Springs who want more than a quick massage, Ryan offers Rolfing Structural Integration and somatic support at his Folsom office.
     </p>
     <p class="mt-6 text-sm uppercase tracking-[0.18em] text-[#c4924a]">
      View local page →
     </p>
    </a>
    <a class="block rounded-3xl bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/serving/cameron-park-rolfing/">
     <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
      Serving Cameron Park
     </p>
     <h2 class="mt-4 text-4xl leading-tight">
      Rolfing near Cameron Park
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      Ryan works with clients from Cameron Park who are looking for structural bodywork, posture support, and a whole-body approach to pain and movement restriction.
     </p>
     <p class="mt-6 text-sm uppercase tracking-[0.18em] text-[#c4924a]">
      View local page →
     </p>
    </a>
    <a class="block rounded-3xl bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/serving/placerville-rolfing/">
     <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
      Serving Placerville
     </p>
     <h2 class="mt-4 text-4xl leading-tight">
      Rolfing near Placerville
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      Ryan’s Rolfing serves Placerville clients who want a detailed, whole-body approach to chronic pain, posture, breath, movement, and embodied change.
     </p>
     <p class="mt-6 text-sm uppercase tracking-[0.18em] text-[#c4924a]">
      View local page →
     </p>
    </a>
    <a class="block rounded-3xl bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/serving/sacramento-rolfing/">
     <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
      Serving Sacramento
     </p>
     <h2 class="mt-4 text-4xl leading-tight">
      Rolfing near Sacramento
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      Ryan’s Folsom office serves Sacramento-area clients seeking Rolfing Structural Integration, trauma-informed bodywork, and Somatic Experiencing.
     </p>
     <p class="mt-6 text-sm uppercase tracking-[0.18em] text-[#c4924a]">
      View local page →
     </p>
    </a>
   </div>
  </section>

  <section class="px-5 py-20">
   <div class="mx-auto max-w-4xl rounded-[2rem] bg-[#545454] p-8 text-white md:p-10">
    <p class="text-sm uppercase tracking-[0.24em] text-[#c4924a]">
     Book in Folsom
    </p>
    <h2 class="mt-4 text-5xl leading-tight text-white">
     One office, a regional client base.
    </h2>
    <p class="mt-6 text-xl leading-9 text-white/82">
     The goal is not to create generic “near me” pages. Each location page helps people nearby understand what Ryan does, where the office is, and whether the drive makes sense for the kind of bodywork they are seeking.
    </p>
    <a class="mt-8 inline-block rounded-full bg-[#c4924a] px-8 py-4 text-sm uppercase tracking-[0.18em] text-white hover:bg-[#9b7139]" href={bookingUrl('serving')}>
     Book online
    </a>
   </div>
  </section>
</Layout>
