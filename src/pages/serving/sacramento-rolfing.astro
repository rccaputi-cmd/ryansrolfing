---
import Layout from '../../layouts/Layout.astro';

const book = 'https://rolfing-106793.square.site';
const map = 'https://www.google.com/maps/search/?api=1&query=101+Parkshore+Drive+Folsom+CA+95630';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where did the Sacramento office go?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ryan used to see clients at 945 University Ave in Sacramento. The practice is now at 101 Parkshore Drive in Folsom, CA 95630.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is the Folsom office far from Sacramento?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'It is an easy drive from Sacramento. The office is near Highway 50, East Bidwell Street, and Folsom Lake Crossing.',
      },
    },
  ],
};
---
<Layout
  title="We Moved to Folsom from Sacramento | Ryan’s Rolfing"
  description="Ryan’s Rolfing has moved from 945 University Ave, Sacramento to 101 Parkshore Drive in Folsom. An easy drive from Sacramento. Book in Folsom."
  schema={schema}
>
  <nav aria-label="Breadcrumb" class="px-5 pt-8">
    <ol class="mx-auto flex max-w-3xl flex-wrap items-center gap-2 text-sm text-[#545454]/70">
      <li><a class="hover:text-[#c4924a]" href="/">Home</a></li>
      <li class="flex items-center gap-2"><span aria-hidden="true">/</span><a class="hover:text-[#c4924a]" href="/serving/">Service Areas</a></li>
      <li class="flex items-center gap-2"><span aria-hidden="true">/</span><span aria-current="page">Formerly Sacramento</span></li>
    </ol>
  </nav>

  <section class="px-5 py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Formerly Sacramento</p>
      <h1 class="mt-5 text-5xl leading-tight md:text-7xl">The office has moved to Folsom.</h1>
      <div class="prose mt-8 text-xl text-[#545454]/85">
        <p>Ryan used to see clients at 945 University Ave in Sacramento. The practice is no longer at that address.</p>
        <p>Ryan’s Rolfing is now at 101 Parkshore Drive, Folsom, CA 95630. It is an easy drive from Sacramento. The office is near Highway 50, East Bidwell Street, and Folsom Lake Crossing.</p>
        <p>The work is the same: Rolfing Structural Integration, and Somatic Experiencing when that is the better fit. Who it helps, what a session is like, and how a first visit goes are on the Folsom page.</p>
        <p>If you still have the old Sacramento address saved, use 101 Parkshore Drive instead.</p>
      </div>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/serving/folsom-rolfing/" class="rounded-full bg-[#c4924a] px-8 py-4 text-center text-sm uppercase tracking-[0.18em] text-white transition hover:bg-[#9b7139]">See the Folsom page</a>
        <a href={book} class="rounded-full border border-[#c4924a] px-8 py-4 text-center text-sm uppercase tracking-[0.18em] text-[#545454] transition hover:bg-[#f8f6f2]">Book a session</a>
      </div>
      <p class="mt-8 text-lg leading-8 text-[#545454]/80">
        <a class="underline decoration-[#c4924a] underline-offset-4" href={map}>Map to 101 Parkshore Drive</a>
        <span aria-hidden="true"> · </span>
        <a class="underline decoration-[#c4924a] underline-offset-4" href="/contact/">Contact</a>
        <span aria-hidden="true"> · </span>
        <a class="underline decoration-[#c4924a] underline-offset-4" href="/faq/">FAQ</a>
      </p>
    </div>
  </section>
</Layout>
