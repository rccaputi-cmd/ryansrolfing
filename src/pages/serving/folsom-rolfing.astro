---
import Layout from '../../layouts/Layout.astro';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is Ryan’s Rolfing close to Folsom?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Ryan works from 101 Parkshore Drive in Folsom, serving clients from Folsom, El Dorado County, and the greater Sacramento area."
        }
      },
      {
        "@type": "Question",
        "name": "What does Rolfing help with?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "People often seek Rolfing for chronic pain, posture, restricted movement, old injury patterns, breathing limitations, and a desire to feel more at home in their body."
        }
      },
      {
        "@type": "Question",
        "name": "How is Rolfing different from massage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Massage often focuses on relaxation and muscle tension. Rolfing Structural Integration studies whole-body patterns, fascia, posture, gravity, movement, and how one area of the body influences another."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rolfing Structural Integration near Folsom, CA",
    "description": "Rolfing Structural Integration in Folsom, CA with Certified Rolfer Ryan Caputi for chronic pain, posture, movement, nervous-system support, and whole-body change.",
    "provider": {
      "@id": "https://ryansrolfing.com/#business"
    },
    "areaServed": {
      "@type": "City",
      "name": "Folsom"
    },
    "serviceType": "Rolfing Structural Integration",
    "url": "https://ryansrolfing.com/serving/folsom-rolfing/"
  }
];
---
<Layout title="Rolfing in Folsom, CA | Ryan’s Rolfing" description="Rolfing Structural Integration in Folsom, CA with Certified Rolfer Ryan Caputi for chronic pain, posture, movement, nervous-system support, and whole-body change." schema={schema}>
  <nav aria-label="Breadcrumb" class="px-5 pt-8">
   <ol class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 text-sm text-[#545454]/70">
    <li>
     <a class="hover:text-[#c4924a]" href="/">
      Home
     </a>
    </li>
    <li class="flex items-center gap-2">
     <span aria-hidden="true">
      /
     </span>
     <a class="hover:text-[#c4924a]" href="/serving/">
      Service Areas
     </a>
    </li>
    <li class="flex items-center gap-2">
     <span aria-hidden="true">
      /
     </span>
     <span aria-current="page">
      Folsom
     </span>
    </li>
   </ol>
  </nav>

  <script type="application/ld+json" is:inline>
   {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://ryansrolfing.com/"},{"@type":"ListItem","position":2,"name":"Service Areas","item":"https://ryansrolfing.com/serving/"},{"@type":"ListItem","position":3,"name":"Folsom"}]}
  </script>

  <section class="px-5 py-20 md:py-28">
   <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">
     Serving Folsom
    </p>
    <h1 class="mt-5 text-5xl leading-none md:text-7xl">
     Rolfing Structural Integration near Folsom, CA.
    </h1>
    <p class="mx-auto mt-7 max-w-3xl text-xl leading-9 text-[#545454]/85">
     Ryan’s Rolfing is based in Folsom, offering Rolfing Structural Integration, Somatic Experiencing, and NeuroAffective Touch for people seeking a deeper approach to pain, posture, stress, and movement.
    </p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
     <a class="rounded-full bg-[#c4924a] px-8 py-4 text-center text-sm uppercase tracking-[0.18em] text-white transition hover:bg-[#9b7139]" href="https://rolfing-106793.square.site">
      Book a session
     </a>
     <a class="rounded-full border border-[#c4924a] px-8 py-4 text-center text-sm uppercase tracking-[0.18em] text-[#545454] transition hover:bg-[#f8f6f2]" href="/contact">
      Ask a question
     </a>
    </div>
   </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
   <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-3">
    <article class="rounded-[2rem] bg-white p-7 shadow-sm">
     <h2 class="text-3xl">
      Rolfing Structural Integration
     </h2>
     <p class="mt-4 text-lg leading-8 text-[#545454]/80">
      Hands-on structural bodywork for posture, chronic pain, breath, gait, mobility, and whole-body organization.
     </p>
    </article>
    <article class="rounded-[2rem] bg-white p-7 shadow-sm">
     <h2 class="text-3xl">
      Somatic Experiencing
     </h2>
     <p class="mt-4 text-lg leading-8 text-[#545454]/80">
      Gentle, body-oriented support for stress, trauma, overwhelm, boundaries, and nervous-system regulation.
     </p>
    </article>
    <article class="rounded-[2rem] bg-white p-7 shadow-sm">
     <h2 class="text-3xl">
      NeuroAffective Touch
     </h2>
     <p class="mt-4 text-lg leading-8 text-[#545454]/80">
      Consent-based somatic touch for regulation, developmental patterns, embodiment, and relational repair.
     </p>
    </article>
   </div>
  </section>

  <section class="px-5 py-20">
   <div class="mx-auto max-w-4xl">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">
     Why clients make the drive
    </p>
    <h2 class="mt-4 text-5xl md:text-6xl">
     A detailed, whole-body approach.
    </h2>
    <div class="prose mt-8 text-xl text-[#545454]/85">
     <p>
      The office is on Parkshore Drive, close to the American River, Folsom Lake Crossing, East Bidwell Street, and Highway 50 access. This is the primary local page for people searching for Rolfing, structural integration, posture work, and chronic-pain bodywork in Folsom itself.
     </p>
     <p>
      Ryan looks beyond isolated symptoms. The painful area may be part of a larger pattern involving the feet, pelvis, ribs, spine, breath, old injuries, and the nervous system.
     </p>
     <p>
      Sessions are careful, collaborative, and specific. The aim is not to force posture into place, but to help the body reorganize with more support, space, and choice.
     </p>
    </div>
   </div>
  </section>

  <section class="bg-white px-5 py-20">
   <div class="mx-auto max-w-6xl">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">
     Helpful Rolfing articles
    </p>
    <h2 class="mt-4 text-5xl md:text-6xl">
     Learn more before making the drive.
    </h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
     <a class="block rounded-3xl bg-[#f8f6f2] p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/blog/rolfing-jaw-neck-headache-connection/">
      <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
       Jaw, neck, and headaches
      </p>
      <h3 class="mt-4 text-3xl leading-tight">
       The Jaw, Neck &amp; Headache Connection
      </h3>
      <p class="mt-4 leading-8 text-[#545454]/80">
       How Rolfing looks at jaw tension, neck pain, headaches, migraines, shoulders, ribs, breath, and posture as connected patterns.
      </p>
     </a>
     <a class="block rounded-3xl bg-[#f8f6f2] p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/blog/rolfing-for-back-pain-folsom/">
      <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
       Back pain and bodywork
      </p>
      <h3 class="mt-4 text-3xl leading-tight">
       Rolfing for Back Pain in Folsom
      </h3>
      <p class="mt-4 leading-8 text-[#545454]/80">
       How Rolfing looks beyond the painful spot to posture, breath, fascia, movement, and whole-body support.
      </p>
     </a>
     <a class="block rounded-3xl bg-[#f8f6f2] p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/blog/rolfing-for-posture-folsom/">
      <p class="text-xs uppercase tracking-[0.22em] text-[#c4924a]">
       Posture and movement
      </p>
      <h3 class="mt-4 text-3xl leading-tight">
       Rolfing for Posture in Folsom
      </h3>
      <p class="mt-4 leading-8 text-[#545454]/80">
       A practical look at posture as support, adaptability, breath, and movement — not rigid correction.
      </p>
     </a>
    </div>
   </div>
  </section>

  <section class="border-t border-[#e8e1d7] bg-white px-5 py-20">
   <div class="mx-auto max-w-4xl">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">
     Local questions
    </p>
    <h2 class="mt-4 text-5xl md:text-6xl">
     Common questions from Folsom clients
    </h2>
    <div class="mt-10 divide-y divide-[#e8e1d7] border-y border-[#e8e1d7]">
     <details class="group py-6">
      <summary class="cursor-pointer list-none text-2xl text-[#545454] marker:hidden">
       <span class="flex items-center justify-between gap-6">
        Is Ryan’s Rolfing close to Folsom?
        <span class="text-[#c4924a] transition group-open:rotate-45">
         +
        </span>
       </span>
      </summary>
      <p class="mt-4 text-lg leading-8 text-[#545454]/80">
       Yes. Ryan works from 101 Parkshore Drive in Folsom, serving clients from Folsom, El Dorado County, and the greater Sacramento area.
      </p>
     </details>
     <details class="group py-6">
      <summary class="cursor-pointer list-none text-2xl text-[#545454] marker:hidden">
       <span class="flex items-center justify-between gap-6">
        What does Rolfing help with?
        <span class="text-[#c4924a] transition group-open:rotate-45">
         +
        </span>
       </span>
      </summary>
      <p class="mt-4 text-lg leading-8 text-[#545454]/80">
       People often seek Rolfing for chronic pain, posture, restricted movement, old injury patterns, breathing limitations, and a desire to feel more at home in their body.
      </p>
     </details>
     <details class="group py-6">
      <summary class="cursor-pointer list-none text-2xl text-[#545454] marker:hidden">
       <span class="flex items-center justify-between gap-6">
        How is Rolfing different from massage?
        <span class="text-[#c4924a] transition group-open:rotate-45">
         +
        </span>
       </span>
      </summary>
      <p class="mt-4 text-lg leading-8 text-[#545454]/80">
       Massage often focuses on relaxation and muscle tension. Rolfing Structural Integration studies whole-body patterns, fascia, posture, gravity, movement, and how one area of the body influences another.
      </p>
     </details>
    </div>
   </div>
  </section>
</Layout>
