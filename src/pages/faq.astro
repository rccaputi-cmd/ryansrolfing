---
import Layout from '../layouts/Layout.astro';
import { bookingUrl } from '../lib/booking';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is Rolfing Structural Integration?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing Structural Integration is hands-on structural bodywork that works with fascia, posture, breath, movement, and whole-body organization. People often seek it for chronic pain, posture issues, restricted movement, old injury patterns, and a desire to feel more at home in their body."
        }
      },
      {
        "@type": "Question",
        "name": "How is Rolfing different from massage?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Massage often focuses on relaxation and muscle tension. Rolfing looks at whole-body patterns: how the feet, legs, pelvis, ribs, spine, breath, fascia, and old injuries influence each other in gravity and movement."
        }
      },
      {
        "@type": "Question",
        "name": "Does Rolfing hurt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing does not have to be painful. Sensation can be strong or specific, but the work should be collaborative and responsive. Ryan adjusts pressure and pacing based on your body and feedback."
        }
      },
      {
        "@type": "Question",
        "name": "How many sessions will I need?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Some people start with one session for a specific issue. Others choose a sequence or the classic Rolfing Ten Series when they want a more complete whole-body process. The right path depends on your goals, history, and how your body responds."
        }
      },
      {
        "@type": "Question",
        "name": "What should I wear to a Rolfing session?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Wear comfortable clothing that allows movement and body assessment. Athletic shorts, a sports bra, or fitted but comfortable garments usually work well. Choose what feels appropriate and workable for you."
        }
      },
      {
        "@type": "Question",
        "name": "Can Rolfing help with back pain, posture, or old injuries?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing may help some people with recurring pain, posture strain, movement restriction, or old injury patterns by addressing the larger body organization around the symptom. It is not a replacement for medical care when symptoms are severe, worsening, or medically concerning."
        }
      },
      {
        "@type": "Question",
        "name": "What is Somatic Experiencing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Somatic Experiencing is a body-oriented approach to stress, trauma, overwhelm, boundaries, and nervous-system regulation. Ryan integrates nervous-system awareness into his broader bodywork practice."
        }
      },
      {
        "@type": "Question",
        "name": "Where is Ryan’s Rolfing located?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ryan’s Rolfing is located at 101 Parkshore Drive in Folsom, California, serving clients from Folsom, El Dorado Hills, Shingle Springs, Cameron Park, Placerville, El Dorado County, and Sacramento."
        }
      },
      {
        "@type": "Question",
        "name": "Are you accepting new clients?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. You can book online through Square, or email Ryan if you are unsure which session type is the best fit."
        }
      }
    ]
  }
];
---
<Layout title="Rolfing FAQ in Folsom, CA | Ryan’s Rolfing" description="Common questions about Rolfing Structural Integration, Somatic Experiencing, what to expect, what to wear, and booking with Ryan’s Rolfing in Folsom, CA." schema={schema}>
  <section class="px-5 py-20 md:py-28">
   <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">
     Rolfing FAQ
    </p>
    <h1 class="mt-5 text-5xl leading-tight md:text-7xl">
     Common questions before starting Rolfing.
    </h1>
    <p class="mx-auto mt-7 max-w-3xl text-xl leading-9 text-[#545454]/85">
     If you are new to Rolfing, Somatic Experiencing, or structural bodywork, start here. These answers cover what the work is, how sessions feel, and how to decide whether it is the right fit.
    </p>
   </div>
  </section>

  <section class="border-t border-[#e8e1d7] bg-white px-5 py-20">
