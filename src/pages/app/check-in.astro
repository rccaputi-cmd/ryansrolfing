---
import AppLayout from '../../layouts/AppLayout.astro';
const prompts = ['What feels easier right now?', 'Where do you notice support?', 'What feels different in your breath?', 'What movement feels more available?', 'What still feels unresolved?', 'What would you like Ryan to know next session?'];
---
<AppLayout title="Check In | Ryan’s Rolfing Companion" active="check">
  <section class="rounded-[2rem] bg-white p-5 shadow-sm">
    <p class="text-xs uppercase tracking-[0.26em] text-[var(--gold-dark)]">2-minute check-in</p>
    <h1 class="mt-2 font-display text-4xl leading-tight">Notice what changed.</h1>
    <p class="mt-3 leading-7 text-[var(--gray)]">No analysis required. Just write what you genuinely notice.</p>
  </section>
  <form class="mt-5 space-y-3" data-clarity-mask="true">
    {prompts.map((prompt) => <label class="block rounded-[1.5rem] bg-white p-4 shadow-sm"><span class="block leading-7">{prompt}</span><textarea class="checkin-note mt-3 h-24 w-full resize-none rounded-2xl border border-[var(--line)] bg-[var(--soft)] p-3 outline-none focus:border-[var(--gold)]" placeholder="Note to self…" data-clarity-mask="true"></textarea></label>)}
  </form>
  <button id="copy-checkin" class="mt-5 w-full rounded-2xl bg-[var(--gold)] px-5 py-4 text-center text-white shadow-sm">Copy notes</button>
  <p id="copy-status" class="mt-3 text-center text-sm text-[var(--gold-dark)]"></p>
  <p class="mt-4 text-xs leading-6 text-[var(--gray)]">Prototype: notes are not saved to Ryan or the cloud yet. Don’t use this for urgent concerns.</p>
  <script>
    const button = document.querySelector('#copy-checkin');
    const status = document.querySelector('#copy-status');
    button?.addEventListener('click', async () => {
      const notes = Array.from(document.querySelectorAll('.checkin-note')).map((el, index) => {
        const label = el.closest('label')?.querySelector('span')?.textContent?.trim() || `Prompt ${index + 1}`;
        return `${label}\n${el.value.trim() || '—'}`;
      }).join('\n\n');
      try {
        await navigator.clipboard.writeText(notes);
        if (status) status.textContent = 'Copied. You can paste this into a message or note.';
      } catch {
        if (status) status.textContent = 'Copy did not work on this browser. Select and copy manually.';
      }
    });
  </script>
</AppLayout>
