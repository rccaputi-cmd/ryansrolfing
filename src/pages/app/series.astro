---
import AppLayout from '../../layouts/AppLayout.astro';
const phases = [['1–3', 'Create better conditions: breath, support, orientation, and the outer sleeve.'], ['4–7', 'Work deeper relationships: pelvis, spine, ribs, head, and inner support.'], ['8–10', 'Integrate the changes so posture, movement, and daily life can reorganize as one system.']];
---
<AppLayout title="Series | Ryan’s Rolfing Companion" active="learn">
  <section class="rounded-[2rem] bg-white p-5 shadow-sm">
    <p class="text-xs uppercase tracking-[0.26em] text-[var(--gold-dark)]">Series map</p>
    <h1 class="mt-2 font-display text-4xl leading-tight">Real change needs time.</h1>
    <p class="mt-3 leading-7 text-[var(--gray)]">You cannot force a plant to grow by pulling on it. With the right attention, conditions, and time, the body can reorganize in a way that lasts.</p>
  </section>
  <section class="mt-5 space-y-3">{phases.map(([title, body]) => <article class="rounded-[1.5rem] bg-white p-5 shadow-sm"><p class="text-xs uppercase tracking-[0.24em] text-[var(--gold-dark)]">Sessions</p><h2 class="font-display text-4xl">{title}</h2><p class="mt-2 leading-7 text-[var(--gray)]">{body}</p></article>)}</section>
</AppLayout>
