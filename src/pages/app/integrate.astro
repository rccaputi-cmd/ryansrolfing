---
import AppLayout from '../../layouts/AppLayout.astro';
const suggestions = ['Take a gentle walk if that feels good.', 'Drink water if you are thirsty.', 'Avoid immediately overloading your system if you feel tender or reorganized.', 'Notice changes without forcing a story around them.', 'Sleep, rest, or quiet time can be part of integration.'];
---
<AppLayout title="Integrate | Ryan’s Rolfing Companion" active="home">
  <section class="rounded-[2rem] bg-white p-5 shadow-sm">
    <p class="text-xs uppercase tracking-[0.26em] text-[var(--gold-dark)]">After session</p>
    <h1 class="mt-2 font-display text-4xl leading-tight">Let the work land.</h1>
    <p class="mt-3 leading-7 text-[var(--gray)]">Your body may keep reorganizing after the session. Give it room.</p>
  </section>
  <section class="mt-5 space-y-3">{suggestions.map((item) => <div class="rounded-[1.5rem] bg-white p-4 leading-7 shadow-sm">{item}</div>)}</section>
  <section class="mt-5 rounded-[2rem] bg-[var(--gold)] p-5 text-white"><h2 class="font-display text-3xl">When in doubt</h2><p class="mt-2 leading-7 text-white/90">If something feels concerning or confusing, contact Ryan directly.</p></section>
</AppLayout>
