---
import Layout from '../layouts/Layout.astro';
import { bookingUrl } from '../lib/booking';
import GoogleRatingBadge from '../components/GoogleRatingBadge.astro';
import SessionPhoto from '../components/SessionPhoto.astro';
import heroStones from '../assets/pages/neuroaffective-touch/nat-hero-river-stones-4x5.jpg';
import nest from '../assets/pages/neuroaffective-touch/nat-section-1-nest-4x3.jpg';
import moss from '../assets/pages/neuroaffective-touch/nat-section-2-moss-granite-4x3.jpg';
import cuppedStone from '../assets/pages/neuroaffective-touch/nat-section-3-cupped-stone-4x3.jpg';
import natoma from '../assets/pages/neuroaffective-touch/nat-card-natoma-mist-4x5.jpg';
import portrait from '../assets/pages/photos/ryan-portrait-studio.jpg';

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=101+Parkshore+Drive+Folsom+CA+95630';
const heroBookUrl = bookingUrl('neuroaffective-touch');
const closeBookUrl = bookingUrl('neuroaffective-touch-close');

const facts = [
  { title: 'You stay clothed', text: 'Always.' },
  { title: 'Touch is optional', text: 'We can stay with talking and body awareness.' },
  { title: 'You choose', text: 'Where, how light, how long.' },
  { title: 'Stop anytime', text: 'Say so, or use your signal.' },
];

const recognize = [
  'You stiffen when someone gets close, even someone you trust.',
  'You go numb, or far away, in tender moments.',
  'You feel guarded, and you don’t know why.',
  'You find it hard to take help, or you give a lot and receive little.',
  'You understand your history well, and your body still reacts.',
];

const session = [
  {
    when: 'About 10 min',
    title: 'Before we start',
    text: 'We talk about what you’d like, what feels okay, and what doesn’t. I explain how touch works in this session.',
  },
  {
    when: 'Together',
    title: 'Choosing the touch',
    text: 'We agree on where, how light, and how long. We agree on a word or signal you can use to pause. You’re clothed.',
  },
  {
    when: 'About 30 min',
    title: 'The work',
    text: 'Often a still, steady hand on a shoulder, the back, the belly, or the legs. You may feel warmth, heaviness, tingling, emotion, nothing at all. We check in often.',
  },
  {
    when: 'About 10 min',
    title: 'Landing',
    text: 'We come back to the room. We notice what’s here. You leave steady.',
  },
];

const touchFaqs = [
  {
    q: 'Do I have to be touched?',
    a: 'No. It’s optional. We can begin with conversation and body awareness, and we can stay there.',
  },
  {
    q: 'What kind of touch?',
    a: 'Light or still contact, not deep tissue. No kneading.',
  },
  {
    q: 'Where?',
    a: 'Only where you’ve said yes. Often shoulders, back, belly, or legs.',
  },
  {
    q: 'What if I want to stop?',
    a: 'Say so, or use your signal. We stop. You never have to explain.',
  },
  {
    q: 'Is this like massage?',
    a: 'It’s not. Massage works on muscle. This is more about listening, support, and how your nervous system responds to contact.',
  },
];

const bookFaqs = [
  { q: 'Do I need to tell my story?', a: 'No. A few words is plenty.' },
  {
    q: 'Do I need to have "trauma"?',
    a: 'No. Many people come simply because they want to feel safer and more at ease in their body.',
  },
  {
    q: 'Is it therapy?',
    a: 'It’s somatic bodywork and nervous-system support. I don’t diagnose. It can sit alongside therapy with a licensed therapist.',
  },
  { q: 'How many sessions?', a: 'It varies. Many people begin with a few and see how it feels.' },
  { q: 'Cost?', a: 'Ask me, or see current options when you book.' },
];

const notices = [
  'you feel a bit more supported',
  'your breath gets easier',
  'tension softens',
  'you feel more of your body',
  'boundaries become clearer',
];

const doors = [
  { label: 'Rolfing', text: 'Structure and movement.', href: '/method/' },
  { label: 'Somatic Experiencing®', text: 'Stress and survival responses.', href: '/somatic-experiencing/' },
  { label: 'NeuroAffective Touch®', text: 'How you take in support and contact.', href: '/neuroaffective-touch/' },
];

const faqs = [...touchFaqs, ...bookFaqs];
const areaServed = ['Folsom', 'El Dorado Hills', 'Cameron Park', 'Orangevale', 'Roseville'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'NeuroAffective Touch®',
    serviceType: 'NeuroAffective Touch',
    description: 'Slow, clothed, consent-based touch in Folsom, CA. We talk first. You decide where, how much, and when to stop.',
    provider: { '@id': 'https://ryansrolfing.com/#business' },
    areaServed,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
];
---
<Layout
  title="Trauma-Informed Bodywork in Folsom, CA | NeuroAffective Touch® | Ryan’s Rolfing"
  description="Gentle, consent-based touch in Folsom. NeuroAffective Touch® is slow, clothed, and always your choice. With Ryan Caputi, 101 Parkshore Dr."
  image="/images/og/nat-og-1200x630.jpg"
  schema={schema}
>
  <section class="px-5 py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
      <div>
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">NeuroAffective Touch® · Folsom, CA</p>
        <h1 class="mt-5 text-5xl leading-tight md:text-7xl">Touch that asks first, and listens.</h1>
        <div class="prose mt-8 text-xl text-[#545454]/85">
          <p>Slow, clothed, and always your call. We talk first. You decide where, how much, and when to stop.</p>
          <p>For many people, the first lessons about safety come through the body. NeuroAffective Touch® is a way of working with that early layer, using gentle, consented touch and plenty of listening.</p>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="rounded-full bg-[#c4924a] px-8 py-4 text-center text-sm uppercase tracking-[0.18em] text-white transition hover:bg-[#9b7139]" href={heroBookUrl}>Book a session</a>
          <a class="rounded-full border border-[#c4924a] px-8 py-4 text-center text-sm uppercase tracking-[0.18em] text-[#545454] transition hover:bg-[#f8f6f2]" href="/contact/">Ask a question</a>
        </div>
        <p class="mt-5 text-sm uppercase tracking-[0.16em] text-[#545454]">Clothed · Touch optional</p>
        <p class="mt-3 text-lg leading-8 text-[#545454]/85">Never touched before? We can start with talking only.</p>
        <p class="mt-6 max-w-xl border-l border-[#c4924a] bg-[#f8f6f2] px-5 py-4 text-lg leading-8">
          <span class="block text-sm uppercase tracking-[0.16em] text-[#c4924a]">Your first session</span>
          Nothing happens in your first session you haven’t said yes to. We can stop anytime, and you’re never expected to book again.
        </p>
        <GoogleRatingBadge class="mt-6" />
        <p class="mt-4 text-lg">
          <a class="underline decoration-[#c4924a] underline-offset-4 hover:text-[#c4924a]" href="/testimonials/">Read client stories</a>
        </p>
        <p class="mt-6 max-w-xl border-t border-[#e8e1d7] pt-5 text-lg leading-8 text-[#545454]/80">
          <span class="text-[#545454]">Scope note:</span> I’m a bodyworker. I don’t diagnose or provide psychotherapy, and this isn’t a substitute for medical or mental health care. I’m happy to work alongside your therapist or doctor. I’m trained in NeuroAffective Touch® (Foundation Training).
        </p>
      </div>
      <SessionPhoto
        src={heroStones}
        alt="A smooth river stone resting in clear, shallow water"
        sizes="(min-width: 768px) 42vw, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-t-full object-cover shadow-xl"
      />
    </div>
    <p class="mx-auto mt-10 max-w-3xl text-xl leading-9 text-[#545454]/85">
      <span class="text-[#545454]">Is this massage?</span> No kneading, no deep pressure. Mostly listening.
    </p>
  </section>

  <section class="border-y border-[#e8e1d7] bg-white">
    <div class="mx-auto grid max-w-6xl sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((fact) => (
        <div class="border-t border-[#e8e1d7] px-6 py-6 sm:border-t-0 sm:border-l sm:first:border-l-0">
          <p class="font-display text-2xl text-[#545454]">{fact.title}</p>
          <p class="mt-1 text-lg leading-7 text-[#545454]/80">{fact.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-b border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
      <SessionPhoto
        src={nest}
        alt="A small bird's nest held in the fork of a mossy branch"
        sizes="(min-width: 768px) 42vw, calc(100vw - 2.5rem)"
        class="aspect-[4/3] w-full rounded-[1.5rem] object-cover"
      />
      <div>
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Why the name?</p>
        <h2 class="mt-4 text-5xl md:text-6xl">Touch with listening in it.</h2>
        <div class="prose mt-6 text-xl text-[#545454]/85">
          <p><span class="text-[#545454]">Neuro</span> is your nervous system. <span class="text-[#545454]">Affective</span> is your feelings. NeuroAffective Touch pays attention to how those two talk to each other, and how touch can support that conversation. It was developed by Dr. Aline LaPierre.</p>
          <p>We don’t push or fix. We pay attention to how your body responds to being supported.</p>
          <p class="text-2xl leading-snug text-[#545454]">"Touch" is the tool. Attention is the practice.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
      <div class="md:order-2">
        <SessionPhoto
          src={moss}
          alt="Soft moss growing over a granite boulder"
          sizes="(min-width: 768px) 42vw, calc(100vw - 2.5rem)"
          class="aspect-[4/3] w-full rounded-[1.5rem] object-cover"
        />
      </div>
      <div class="md:order-1">
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">When people reach out</p>
        <h2 class="mt-4 text-5xl md:text-6xl">You might recognize some of this.</h2>
        <ul class="mt-6">
          {recognize.map((item) => (
            <li class="border-b border-[#e8e1d7] py-4 text-xl leading-8 text-[#545454]">{item}</li>
          ))}
        </ul>
        <p class="mt-5 text-lg leading-8 text-[#545454]/75">Many people come for tension and pain too, and find it’s tied to how they’ve learned to brace.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Your first session</p>
        <h2 class="mt-4 text-5xl md:text-6xl">Slow, planned together, and steady.</h2>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {session.map((step) => (
          <article class="border-t border-[#c4924a] bg-white p-6">
            <p class="text-sm uppercase tracking-[0.16em] text-[#c4924a]">{step.when}</p>
            <h3 class="mt-3 text-3xl">{step.title}</h3>
            <p class="mt-4 text-lg leading-8 text-[#545454]/85">{step.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 text-center text-lg text-[#545454]/75">Times are approximate.</p>
      <p class="mx-auto mt-8 max-w-xl border-l border-[#c4924a] bg-white px-5 py-4 text-lg leading-8">
        <span class="block text-sm uppercase tracking-[0.16em] text-[#c4924a]">Your first session</span>
        Nothing happens in your first session you haven’t said yes to. We can stop anytime, and you’re never expected to book again.
      </p>
    </div>
  </section>

  <section class="bg-white px-5 py-16">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
      <GoogleRatingBadge />
      <a class="text-lg underline decoration-[#c4924a] underline-offset-4 hover:text-[#c4924a]" href="/testimonials/">Read client stories</a>
    </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-start gap-12 md:grid-cols-2">
      <div>
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Touch questions, answered</p>
        <h2 class="mt-4 text-5xl md:text-6xl">Nothing is assumed.</h2>
        <SessionPhoto
          src={cuppedStone}
          alt="Two hands gently cupping a smooth stone by a stream"
          sizes="(min-width: 768px) 40vw, calc(100vw - 2.5rem)"
          class="mt-8 aspect-[4/3] w-full rounded-[1.5rem] object-cover"
        />
      </div>
      <div>
        <div class="divide-y divide-[#e8e1d7] border-y border-[#e8e1d7]">
          {touchFaqs.map((faq) => (
            <details class="group py-6">
              <summary class="cursor-pointer list-none text-2xl text-[#545454] marker:hidden">
                <span class="flex items-center justify-between gap-6">
                  {faq.q}
                  <span class="text-[#c4924a] transition group-open:rotate-45">+</span>
                </span>
              </summary>
              <p class="mt-4 text-lg leading-8 text-[#545454]/80">{faq.a}</p>
            </details>
          ))}
        </div>
        <p class="mt-8 text-sm uppercase tracking-[0.28em] text-[#c4924a]">What to wear and bring</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          <li class="rounded-full border border-[#e8e1d7] bg-white px-4 py-2 text-[#545454]">Comfortable clothes</li>
          <li class="rounded-full border border-[#e8e1d7] bg-white px-4 py-2 text-[#545454]">Water</li>
          <li class="rounded-full border border-[#e8e1d7] bg-white px-4 py-2 text-[#545454]">Nothing to prepare</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-start gap-12 md:grid-cols-2">
      <article class="border-t border-[#c4924a] bg-[#f8f6f2] p-8">
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">What you might notice</p>
        <h3 class="mt-4 text-4xl">Many people notice some of these. It varies.</h3>
        <ul class="mt-6">
          {notices.map((item) => (
            <li class="border-b border-[#e8e1d7] py-3 text-xl leading-8 text-[#545454] last:border-b-0">{item}</li>
          ))}
        </ul>
        <p class="mt-4 text-lg text-[#545454]/75">Nothing is guaranteed.</p>
      </article>
      <div>
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">How it works with Rolfing and Somatic Experiencing</p>
        <h2 class="mt-4 text-5xl md:text-6xl">Three doors into the same body.</h2>
        <div class="mt-8 grid gap-4">
          {doors.map((door) => (
            <a class="border-t border-[#c4924a] bg-[#f8f6f2] p-5 transition hover:bg-white" href={door.href}>
              <p class="text-sm uppercase tracking-[0.16em] text-[#c4924a]">{door.label}</p>
              <p class="mt-2 text-xl text-[#545454]">{door.text}</p>
            </a>
          ))}
        </div>
        <p class="mt-6 text-xl leading-9 text-[#545454]/85">Which one fits best depends on you. Often I blend them. Tell me what’s going on, and we’ll figure it out together.</p>
      </div>
    </div>

    <div class="mx-auto mt-16 grid max-w-6xl items-center gap-10 rounded-[1.5rem] border border-[#e8e1d7] bg-[#f8f6f2] p-6 md:grid-cols-[240px_1fr] md:p-8">
      <SessionPhoto
        src={portrait}
        alt="Ryan Caputi in a studio portrait"
        sizes="(min-width: 768px) 240px, calc(100vw - 5rem)"
        class="mx-auto aspect-[4/5] w-full max-w-[280px] rounded-t-full object-cover"
      />
      <div>
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">About Ryan</p>
        <h3 class="mt-3 text-4xl">Hi, I’m Ryan.</h3>
        <p class="mt-4 text-xl leading-9 text-[#545454]/85">In my Folsom practice I work with Rolfing, Somatic Experiencing, and NeuroAffective Touch, slowly, with permission, and at your pace.</p>
        <p class="mt-4 text-lg leading-8 text-[#545454]/80">I’m trained in NeuroAffective Touch® (Foundation Training).</p>
      </div>
    </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">More questions</p>
        <h2 class="mt-4 text-5xl md:text-6xl">Before you book</h2>
      </div>
      <div class="mt-10 divide-y divide-[#e8e1d7] border-y border-[#e8e1d7]">
        {bookFaqs.map((faq) => (
          <details class="group py-6">
            <summary class="cursor-pointer list-none text-2xl text-[#545454] marker:hidden">
              <span class="flex items-center justify-between gap-6">
                {faq.q}
                <span class="text-[#c4924a] transition group-open:rotate-45">+</span>
              </span>
            </summary>
            <p class="mt-4 text-lg leading-8 text-[#545454]/80">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[1.5rem] border border-[#e8e1d7] bg-[#f8f6f2] md:grid-cols-[1.1fr_.9fr]">
      <div class="px-8 py-12 md:px-12">
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Where are you?</p>
        <h2 class="mt-4 text-5xl md:text-6xl">Folsom, near Lake Natoma and the American River Parkway.</h2>
        <p class="mt-6 text-xl leading-9 text-[#545454]/85">Not far from El Dorado Hills, Cameron Park, Orangevale, and Roseville.</p>
        <a class="mt-6 inline-block rounded-xl bg-white px-4 py-3 text-[#545454] hover:text-[#c4924a]" href={mapsUrl}>101 Parkshore Drive, Folsom, CA 95630</a>
      </div>
      <SessionPhoto
        src={natoma}
        alt="Morning mist over a calm river with trees along the bank"
        sizes="(min-width: 768px) 36vw, calc(100vw - 2.5rem)"
        class="aspect-[4/5] h-full w-full object-cover md:min-h-[420px]"
      />
    </div>
  </section>

  <section class="px-5 pb-16">
    <div class="mx-auto max-w-4xl rounded-[1.5rem] bg-[#545454] px-8 py-16 text-center text-white md:px-16">
      <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Start when you’re ready</p>
      <h2 class="mt-4 text-5xl text-white md:text-6xl">Send a question. Book a session. Or just come in and see how it feels.</h2>
      <a class="mt-8 inline-block rounded-full bg-[#c4924a] px-8 py-4 text-sm uppercase tracking-[0.18em] text-white transition hover:bg-[#9b7139]" href={closeBookUrl}>Book a session</a>
      <p class="mt-6 text-lg text-white/85">Clothed · touch optional · <a class="underline decoration-white/40 underline-offset-4 hover:text-white" href={mapsUrl}>101 Parkshore Drive, Folsom, CA 95630</a></p>
      <p class="mt-4 text-lg text-white/80">Never touched before? We can start with talking only. <a class="underline decoration-white/40 underline-offset-4 hover:text-white" href="/contact/">Ask a question first</a></p>
      <p class="mx-auto mt-10 max-w-3xl text-sm leading-7 text-white/70">NeuroAffective Touch® is offered as wellness, bodywork, and nervous-system support. It’s not a substitute for medical care, psychotherapy, or emergency mental health support. Results vary.</p>
    </div>
  </section>
</Layout>
