---
import Layout from '../layouts/Layout.astro';
import GoogleRatingBadge from '../components/GoogleRatingBadge.astro';
import SessionPhoto from '../components/SessionPhoto.astro';
import seCard from '../assets/pages/somatic-experiencing/se-card-lone-oak-4x5.jpg';
import natCard from '../assets/pages/neuroaffective-touch/nat-card-natoma-mist-4x5.jpg';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "item": {
          "@type": "Service",
          "name": "Individual Rolfing Sessions",
          "description": "Try Rolfing, work on a particular issue, or receive maintenance to keep your body healthy and feeling good.",
          "areaServed": [
            "Folsom",
            "El Dorado Hills",
            "Shingle Springs",
            "Cameron Park",
            "Placerville",
            "Sacramento"
          ],
          "provider": {
            "@id": "https://ryansrolfing.com/#business"
          }
        }
      },
      {
        "@type": "ListItem",
        "position": 2,
        "item": {
          "@type": "Service",
          "name": "Rolfing Ten Series",
          "description": "For people who want to invest in their health and body in a big way — the pinnacle sequence of Rolfing Structural Integration.",
          "areaServed": [
            "Folsom",
            "El Dorado Hills",
            "Shingle Springs",
            "Cameron Park",
            "Placerville",
            "Sacramento"
          ],
          "provider": {
            "@id": "https://ryansrolfing.com/#business"
          }
        }
      },
      {
        "@type": "ListItem",
        "position": 3,
        "item": {
          "@type": "Service",
          "name": "Somatic Experiencing",
          "description": "A gentle, body-based way of working with stress and overwhelm.",
          "areaServed": [
            "Folsom",
            "El Dorado Hills",
            "Shingle Springs",
            "Cameron Park",
            "Placerville",
            "Sacramento"
          ],
          "provider": {
            "@id": "https://ryansrolfing.com/#business"
          }
        }
      },
      {
        "@type": "ListItem",
        "position": 4,
        "item": {
          "@type": "Service",
          "name": "NeuroAffective Touch",
          "description": "Slow, clothed, consent-based touch. We talk first. You decide where, how much, and when to stop.",
          "areaServed": [
            "Folsom",
            "El Dorado Hills",
            "Shingle Springs",
            "Cameron Park",
            "Placerville",
            "Sacramento"
          ],
          "provider": {
            "@id": "https://ryansrolfing.com/#business"
          }
        }
      }
    ]
  }
];
---
<Layout title="Rolfing, Somatic Experiencing & NeuroAffective Touch in Folsom, CA | Ryan’s Rolfing" description="Folsom, CA. Book Rolfing Structural Integration, the Rolfing Ten Series, Somatic Experiencing, and NeuroAffective Touch with Ryan Caputi." schema={schema}>
  <section class="px-5 py-20 md:py-28">
   <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">
     Services in Folsom, CA
    </p>
    <h1 class="mt-5 text-6xl leading-none md:text-8xl">
     Choose the right starting point.
    </h1>
    <p class="mt-6 text-xl leading-9 text-[#545454]/85">
     Sessions are at <a class="underline decoration-[#c4924a] underline-offset-4 hover:text-[#c4924a]" href="https://www.google.com/maps/search/?api=1&query=101+Parkshore+Drive+Folsom+CA+95630">101 Parkshore Drive, Folsom, CA 95630</a>, near Lake Natoma and the American River Parkway. Easy to reach from El Dorado Hills, Cameron Park, Orangevale, and Roseville.
    </p>
   </div>
   <div class="mx-auto mt-16 grid max-w-6xl gap-6 md:grid-cols-2 xl:grid-cols-4">
    <a class="flex flex-col border-t border-[#c4924a] bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/method/">
     <h2 class="text-4xl">
      Individual Rolfing Sessions
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      Try Rolfing, work on a particular issue, or receive maintenance to keep your body healthy and feeling good.
     </p>
    </a>
    <a class="flex flex-col border-t border-[#c4924a] bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/method/">
     <h2 class="text-4xl">
      Rolfing Ten Series
     </h2>
     <p class="mt-5 leading-8 text-[#545454]/80">
      For people who want to invest in their health and body in a big way — the pinnacle sequence of Rolfing Structural Integration.
     </p>
    </a>
    <a class="flex flex-col overflow-hidden border-t border-[#c4924a] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/somatic-experiencing/">
     <SessionPhoto src={seCard} alt="A lone oak standing in a green field under a blue sky" sizes="(min-width: 1280px) 22vw, (min-width: 768px) 45vw, calc(100vw - 2.5rem)" class="aspect-[4/5] w-full object-cover" />
     <div class="p-7">
      <h2 class="text-4xl">
       Somatic Experiencing
      </h2>
      <p class="mt-5 leading-8 text-[#545454]/80">
       A gentle, body-based way of working with stress and overwhelm.
      </p>
     </div>
    </a>
    <a class="flex flex-col overflow-hidden border-t border-[#c4924a] bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-md" href="/neuroaffective-touch/">
     <SessionPhoto src={natCard} alt="Morning mist over a calm river with trees along the bank" sizes="(min-width: 1280px) 22vw, (min-width: 768px) 45vw, calc(100vw - 2.5rem)" class="aspect-[4/5] w-full object-cover" />
     <div class="p-7">
      <h2 class="text-4xl">
       NeuroAffective Touch
      </h2>
      <p class="mt-5 leading-8 text-[#545454]/80">
       Slow, clothed, consent-based touch. We talk first. You decide where, how much, and when to stop.
      </p>
     </div>
    </a>
   </div>
   <!-- Pricing -->
   <div class="mx-auto mt-16 max-w-3xl text-center">
    <h2 class="text-4xl">
     Pricing
    </h2>
    <div class="mt-6 space-y-1 text-xl">
     <p>
      <strong>
       Rolfing Session:
      </strong>
      $270
     </p>
     <p class="mt-1 text-[#545454]/80">
      No package deals available at this time.
     </p>
     <p class="mt-1 text-lg text-[#545454]/85">
      Rolfing sessions range from 60 to 90 minutes and end organically based on the goals for that day.
     </p>
     <p class="mt-4">
      <strong>
       Somatic Experiencing Session:
      </strong>
      $230
      <span class="text-base text-[#545454]/70">
       (50 minutes)
      </span>
     </p>
     <p class="mt-1">
      <strong>
       Somatic Experiencing Session (75 minutes):
      </strong>
      $270
     </p>
    </div>
   </div>
   <div class="mx-auto mt-12 max-w-3xl rounded-3xl bg-[#f8f6f2] p-7 text-center">
    <h2 class="text-4xl">
     Ready to schedule?
    </h2>
    <p class="mt-4 text-xl leading-8 text-[#545454]/85">
     Choose the session type that fits your goals and book online through Square.
    </p>
    <GoogleRatingBadge align="center" class="mt-6" />
    <a class="mt-4 inline-block rounded-full bg-[#c4924a] px-8 py-4 text-sm uppercase tracking-[0.18em] text-white hover:bg-[#9b7139]" href="https://rolfing-106793.square.site">
     Book online
    </a>
   </div>
  </section>
</Layout>
