---
import Layout from '../layouts/Layout.astro';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rolfing for Sciatica in Folsom",
    "description": "Rolfing Structural Integration in Folsom for sciatica-type buttock and leg pain tied to pelvic, hip, and low-back patterns. Not medical care for nerve injury.",
    "provider": {
      "@id": "https://ryansrolfing.com/#business"
    },
    "areaServed": [
      "Folsom",
      "El Dorado Hills",
      "Shingle Springs",
      "Cameron Park",
      "Placerville",
      "Sacramento"
    ],
    "url": "https://ryansrolfing.com/rolfing-for-sciatica-folsom/",
    "serviceType": "Rolfing Structural Integration"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can Rolfing help sciatica?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing may support some people whose buttock or leg pain is tied to posture, hip and pelvic strain, and how the low back shares load. It does not diagnose or treat nerve injury, and it is not a cure for sciatica."
        }
      },
      {
        "@type": "Question",
        "name": "Do you work on the nerve?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Sessions work with fascia, the soft tissue around the pelvis and legs, and movement patterns. Ryan does not claim to free a trapped nerve."
        }
      },
      {
        "@type": "Question",
        "name": "Should I come in during a bad flare?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "If you cannot walk, the pain is severe, or weakness or numbness is new, get medical care first. If the symptoms are familiar and you can move enough to lie down and walk a little, a session can be paced to what you can tolerate that day."
        }
      },
      {
        "@type": "Question",
        "name": "When should I see a doctor first?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Seek medical care first for sudden or severe leg pain, progressive weakness, saddle numbness, bowel or bladder changes, fever, unexplained weight loss, or pain after trauma."
        }
      }
    ]
  }
];
