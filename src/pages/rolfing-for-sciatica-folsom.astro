      Book a session
     </a>
     <a class="inline-block rounded-full border border-[#c4924a] px-8 py-4 text-sm uppercase tracking-[0.18em] text-[#c4924a] hover:bg-[#f8f6f2]" href="/rolfing-for-back-pain-folsom/">
      Low back pain
     </a>
     <a class="inline-block rounded-full border border-[#c4924a] px-8 py-4 text-sm uppercase tracking-[0.18em] text-[#c4924a] hover:bg-[#f8f6f2]" href="/serving/folsom-rolfing/">
      Folsom office
     </a>
    </div>
    <p>
     Related:
     <a class="text-[#c4924a] underline-offset-4 hover:underline" href="/rolfing-for-knee-pain-folsom/">knee pain</a>,
     <a class="text-[#c4924a] underline-offset-4 hover:underline" href="/rolfing-for-ankle-foot-pain-folsom/">ankle and foot pain</a>,
     <a class="text-[#c4924a] underline-offset-4 hover:underline" href="/rolfing-for-neck-pain-folsom/">neck pain</a>.
    </p>
   </section>
  </article>
</Layout>
