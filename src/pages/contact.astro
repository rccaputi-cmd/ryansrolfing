---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Ryan’s Rolfing | Book in Folsom, CA" description="Book Rolfing Structural Integration or Somatic Experiencing with Ryan Caputi at Ryan’s Rolfing, 101 Parkshore Drive in Folsom, CA.">
  <section class="px-5 py-20 md:py-28">
   <div class="mx-auto max-w-4xl">
    <p class="text-sm font-bold uppercase tracking-[0.22em] text-[#8b642f]">
     Contact
    </p>
    <h1 class="mt-5 text-5xl font-semibold tracking-tight md:text-7xl">
     Ready when your body is.
    </h1>
    <p class="mt-6 text-xl leading-9 text-[#6f6258]">
     Book online, send a question, or find the office in Folsom.
    </p>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
     <a class="rounded-3xl border border-[#e8dcc7] bg-[#fffaf1] p-6 hover:border-[#c4924a]" href="https://rolfing-106793.square.site">
      <strong>
       Book Online
      </strong>
      <br/>
      <span class="text-[#6f6258]">
       Square appointments
      </span>
     </a>
     <a class="rounded-3xl border border-[#e8dcc7] bg-[#fffaf1] p-6 hover:border-[#c4924a]" href="mailto:info@ryansrolfing.com">
      <strong>
       Email
      </strong>
      <br/>
      <span class="text-[#6f6258]">
       info@ryansrolfing.com
      </span>
     </a>
     <a class="rounded-3xl border border-[#e8dcc7] bg-[#fffaf1] p-6 hover:border-[#c4924a]" href="https://www.google.com/maps/search/?api=1&amp;query=101+Parkshore+Drive+Folsom+CA+95630">
      <strong>
       Office
      </strong>
      <br/>
      <span class="text-[#6f6258]">
       101 Parkshore Drive, Folsom
      </span>
     </a>
    </div>
    <div class="mt-10 rounded-2xl bg-[#fffaf1] p-6 text-[#6f6258]">
     <h2 class="text-3xl text-[#545454]">
      Not sure where to start?
     </h2>
     <p class="mt-3 leading-8">
      If you are unsure which session type fits best, email Ryan and he can help you choose the best next step.
     </p>
    </div>
   </div>
  </section>
</Layout>
