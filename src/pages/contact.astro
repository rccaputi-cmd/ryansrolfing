---
import Layout from '../layouts/Layout.astro';
import { bookingUrl } from '../lib/booking';

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=101+Parkshore+Drive+Folsom+CA+95630';
const bookUrl = bookingUrl('contact');
---
<Layout title="Contact Ryan’s Rolfing in Folsom, CA" description="Folsom, CA. Book Rolfing, Somatic Experiencing®, or NeuroAffective Touch® with Ryan Caputi at 101 Parkshore Drive.">
  <section class="px-5 py-20 md:py-28">
    <div class="mx-auto max-w-4xl">
      <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Contact · Folsom, CA</p>
      <h1 class="mt-5 text-6xl leading-none md:text-8xl">Ready when your body is.</h1>
      <p class="mt-6 text-xl leading-9 text-[#545454]/85">Book online, send a question, or find the office in Folsom, CA.</p>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <a class="rounded-3xl bg-[#c4924a] p-6 text-white transition hover:bg-[#9b7139]" href={bookUrl}>
          <span class="block text-sm uppercase tracking-[0.16em]">Book online</span>
          <span class="mt-3 block text-lg leading-7">Square appointments</span>
        </a>
        <a class="rounded-3xl border border-[#e8e1d7] bg-[#f8f6f2] p-6 transition hover:border-[#c4924a]" href="mailto:info@ryansrolfing.com">
          <span class="block text-sm uppercase tracking-[0.16em] text-[#c4924a]">Email</span>
          <span class="mt-3 block text-lg leading-7 text-[#545454]">info@ryansrolfing.com</span>
        </a>
        <a class="rounded-3xl border border-[#e8e1d7] bg-[#f8f6f2] p-6 transition hover:border-[#c4924a]" href={mapsUrl}>
          <span class="block text-sm uppercase tracking-[0.16em] text-[#c4924a]">Office</span>
          <span class="mt-3 block text-lg leading-7 text-[#545454]">101 Parkshore Drive, Folsom, CA 95630</span>
        </a>
      </div>
      <div class="mt-8 rounded-3xl border border-[#e8e1d7] bg-white p-6">
        <p class="text-xl leading-9 text-[#545454]/85">The office is near Lake Natoma and the American River Parkway. Easy to reach from El Dorado Hills, Cameron Park, Orangevale, and Roseville.</p>
      </div>

      <form
        class="mt-10 rounded-3xl border border-[#e8e1d7] bg-[#f8f6f2] p-6 md:p-8"
        name="contact"
        method="POST"
        action="/contact/thanks/"
        data-netlify="true"
        data-clarity-mask="true"
        netlify-honeypot="bot-field"
      >
        <h2 class="text-3xl">Send a note</h2>
        <p class="mt-3 text-xl leading-8 text-[#545454]/85">If you’re not sure which session fits, write me and I’ll help you choose. I reply by email.</p>
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden" aria-hidden="true">
          <label>
            Don’t fill this out if you’re human:
            <input name="bot-field" tabindex="-1" autocomplete="off" data-clarity-mask="true" />
          </label>
        </p>
        <div class="mt-6 grid gap-5">
          <label class="block text-sm uppercase tracking-[0.16em] text-[#545454]" for="contact-name">
            Name
            <input id="contact-name" class="mt-2 w-full rounded-2xl border border-[#e8e1d7] bg-white px-4 py-3 text-base normal-case tracking-normal text-[#545454] outline-none focus:border-[#c4924a]" type="text" name="name" required autocomplete="name" data-clarity-mask="true" />
          </label>
          <label class="block text-sm uppercase tracking-[0.16em] text-[#545454]" for="contact-email">
            Email
            <input id="contact-email" class="mt-2 w-full rounded-2xl border border-[#e8e1d7] bg-white px-4 py-3 text-base normal-case tracking-normal text-[#545454] outline-none focus:border-[#c4924a]" type="email" name="email" required autocomplete="email" data-clarity-mask="true" />
          </label>
          <label class="block text-sm uppercase tracking-[0.16em] text-[#545454]" for="contact-message">
            Message <span class="normal-case tracking-normal text-[#545454]/70">(optional)</span>
            <textarea id="contact-message" class="mt-2 w-full rounded-2xl border border-[#e8e1d7] bg-white px-4 py-3 text-base normal-case tracking-normal text-[#545454] outline-none focus:border-[#c4924a]" name="message" rows="5" data-clarity-mask="true"></textarea>
          </label>
        </div>
        <button class="mt-6 rounded-full bg-[#545454] px-8 py-4 text-sm uppercase tracking-[0.18em] text-white transition hover:bg-[#3f3f3f]" type="submit">Send</button>
      </form>
    </div>
  </section>
</Layout>
