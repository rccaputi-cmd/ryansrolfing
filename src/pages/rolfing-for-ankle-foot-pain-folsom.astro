    <li>
     <a class="hover:text-[#c4924a]" href="/">
      Home
     </a>
    </li>
    <li class="flex items-center gap-2">
     <span aria-hidden="true">
      /
     </span>
     <span aria-current="page">
      Specialties
     </span>
    </li>
    <li class="flex items-center gap-2">
     <span aria-hidden="true">
      /
     </span>
