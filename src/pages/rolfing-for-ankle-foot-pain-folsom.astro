---
import Layout from '../layouts/Layout.astro';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rolfing for Ankle and Foot Pain in Folsom",
    "description": "Rolfing Structural Integration in Folsom for recurring ankle and foot strain, old sprains, and the way the feet support the knees, hips, and low back.",
    "provider": {
      "@id": "https://ryansrolfing.com/#business"
    },
    "areaServed": [
      "Folsom",
      "El Dorado Hills",
      "Shingle Springs",
      "Cameron Park",
      "Placerville",
      "Sacramento"
    ],
    "url": "https://ryansrolfing.com/rolfing-for-ankle-foot-pain-folsom/",
    "serviceType": "Rolfing Structural Integration"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can Rolfing help ankle or foot pain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Rolfing may support some people with recurring foot and ankle strain by working with the foot, lower leg, and how weight travels up through the knee, hip, and back. It is not medical or podiatric treatment."
        }
      },
      {
        "@type": "Question",
        "name": "Do you work on the feet themselves?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, when the feet are part of the pattern. Sessions also look above the ankle, because a guarded foot often changes the whole leg."
        }
      },
      {
        "@type": "Question",
        "name": "What if I have plantar fasciitis or an old sprain?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Those labels cover a range of problems. Ryan does not diagnose them. If the issue is recurring and you are medically cleared, sessions can look at the foot and the way you load it. A new injury, tear, or stress fracture is a medical question first."
        }
      },
      {
        "@type": "Question",
        "name": "When should I see a doctor first?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Seek medical care first for a foot or ankle that is hot, very swollen, bruised after an injury, numb, or too painful to bear weight, and for wounds, signs of infection, or pain that is sudden or worsening."
        }
      }
    ]
  }
];
---
<Layout title="Rolfing for Ankle & Foot Pain in Folsom | Ryan’s Rolfing" description="Rolfing Structural Integration in Folsom for recurring ankle and foot strain, old sprains, and the way the feet support the knees, hips, and low back." schema={schema}>
  <nav aria-label="Breadcrumb" class="px-5 pt-8">
