---
import Layout from '../layouts/Layout.astro';
import SessionPhoto from '../components/SessionPhoto.astro';
import heroDeer from '../assets/pages/somatic-experiencing/se-hero-meadow-deer-4x5.jpg';
import deerSettled from '../assets/pages/somatic-experiencing/se-section-3-deer-settled-4x3.jpg';
import orientingBird from '../assets/pages/somatic-experiencing/se-section-1-orienting-bird-4x3.jpg';
import oakLight from '../assets/pages/somatic-experiencing/se-section-2-oak-light-4x3.jpg';
import loneOak from '../assets/pages/somatic-experiencing/se-card-lone-oak-4x5.jpg';

const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=101+Parkshore+Drive+Folsom+CA+95630';
const bookUrl = 'https://rolfing-106793.square.site';

const experiences = [
  {
    title: 'Overwhelming whole-body stress',
    items: [
      'Pre- and perinatal trauma (fetal distress, birth trauma, early surgeries)',
      'Anesthesia',
      'High fevers',
      'Suffocation, choking, drowning',
    ],
  },
  {
    title: 'High impact and failure of physical defense',
    items: ['Falls', 'Acquired brain injury', 'High impact and motor vehicle accidents'],
  },
  {
    title: 'Inescapable attack',
    items: ['Animal attack', 'Escape inhibited'],
  },
  {
    title: 'Physical injury',
    items: ['Surgery', 'Poison', 'Burns'],
  },
  {
    title: 'Natural and man-made disasters',
    items: ['Natural disasters', 'Horror'],
  },
];

const who = [
  'feel on high alert, or shut down, or go back and forth between the two',
  'have a hard time settling, sleeping, or taking a full breath',
  'still feel an accident, a fall, a surgery, or a hard stretch in their body',
  'want more ease and presence in their own skin',
];

const together = [
  { title: 'It’s slow.', text: 'We go a little at a time, with breaks.' },
  { title: 'You choose what to share.', text: 'A headline is enough. You never have to tell the whole story.' },
  { title: 'It’s usually quiet.', text: 'Sessions are rarely dramatic.' },
  { title: 'You leave steady.', text: 'We take time to settle before you go, so you can head back into your day.' },
];

const notices = [
  'a deeper breath, a sigh, or a yawn',
  'muscles let go, and your weight sinks a little more into the chair',
  'warmth, or a bit of color, coming back to your hands or face',
  'a gentle shake or tremble that comes and goes',
  'your belly gurgles, or you notice you’re hungry',
  'your eyes want to look around, and you feel more like connecting with people',
  'more room inside, and more of you feels like yours',
  'stress feels a bit easier to be with, and you pause before you react',
];

const faqs = [
  {
    q: 'Do I have to talk about what happened to me?',
    a: 'No. You can share as little as you like. A headline is enough.',
  },
  {
    q: 'How is this different from talk therapy?',
    a: 'Talk therapy helps, and it can help your system settle too. Sometimes that settling happens without you noticing. SE goes slowly enough that you can feel it happen and learn what it’s like. Many people do both, and they fit together well.',
  },
  {
    q: 'What might I feel afterward?',
    a: 'Tired, light, a little emotional, or just calm. Drink water and go easy on yourself that evening.',
  },
  {
    q: 'How many sessions will I need?',
    a: 'It varies. Many people try a few sessions to see how it feels. We can check in as we go.',
  },
  {
    q: 'Is touch part of it?',
    a: 'Not necessarily. Many sessions have none. If it ever comes up, I’ll ask first, and you can always say no.',
  },
  {
    q: 'What does it cost, and how long is a session?',
    a: 'There are two session options: 50 minutes $230, and 75 minutes $270.',
  },
  {
    q: 'Can I do this alongside my therapist or doctor?',
    a: 'Yes. That’s often the best setup.',
  },
];

const areaServed = ['Folsom', 'El Dorado Hills', 'Cameron Park', 'Orangevale', 'Roseville'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Somatic Experiencing®',
    serviceType: 'Somatic Experiencing',
    description: 'A gentle, body-based way of working with stress and overwhelm in Folsom, CA.',
    provider: { '@id': 'https://ryansrolfing.com/#business' },
    areaServed,
    offers: [
      {
        '@type': 'Offer',
        name: 'Somatic Experiencing session, 50 minutes',
        price: '230',
        priceCurrency: 'USD',
      },
      {
        '@type': 'Offer',
        name: 'Somatic Experiencing session, 75 minutes',
        price: '270',
        priceCurrency: 'USD',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Ryan tells the deer story',
    description: 'Ryan Caputi tells the deer story (1:28), a picture of how the nervous system can settle after a startle.',
    thumbnailUrl: 'https://ryansrolfing.com/video/se-deer-story-poster.jpg',
    uploadDate: '2026-10-15',
    duration: 'PT1M28S',
    contentUrl: 'https://ryansrolfing.com/video/se-deer-story-web.mp4',
    embedUrl: 'https://ryansrolfing.com/somatic-experiencing/',
  },
];
---
<Layout
  title="Somatic Experiencing® in Folsom, CA | Somatic Bodywork | Ryan’s Rolfing"
  description="Gentle, body-based Somatic Experiencing® in Folsom for stress and overwhelm that lives in the body. 50 or 75 minutes with Ryan Caputi, 101 Parkshore Dr. You set the pace."
  image="/images/og/se-og-1200x630.jpg"
  schema={schema}
>
  <section class="px-5 py-16 md:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-2">
      <div>
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Somatic Experiencing® · Folsom, CA</p>
        <h1 class="mt-5 text-5xl leading-tight md:text-7xl">A gentle, body-based way of working with stress and overwhelm</h1>
        <div class="prose mt-8 text-xl text-[#545454]/85">
          <p>Somatic Experiencing® is a gentle body-based way of working with stress and overwhelm. It’s about re-establishing the body’s ability to naturally discharge stress and overwhelm at a pace that doesn’t re-traumatize. We do this by learning the unspoken language of the body and re-establishing the mind-body connection.</p>
        </div>
      </div>
      <SessionPhoto
        src={heroDeer}
        alt="A deer standing calmly in a golden oak meadow at sunrise"
        sizes="(min-width: 768px) 42vw, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/5] w-full rounded-t-full object-cover shadow-xl"
      />
    </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-white px-5 py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-5xl md:text-6xl">Experiences people bring</h2>
        <p class="mt-6 text-xl leading-9 text-[#545454]/85">Somatic Experiencing groups hard experiences into categories, based on how they tend to affect the nervous system. Here they are as the training names them. You never have to pick one, and you never have to explain yours.</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {experiences.slice(0, 2).map((group) => (
          <article class="border-t border-[#c4924a] bg-[#f8f6f2] p-7">
            <h3 class="text-3xl">{group.title}</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-2xl bg-white px-4 py-2 text-base leading-6 text-[#545454]">{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {experiences.slice(2).map((group) => (
          <article class="border-t border-[#c4924a] bg-[#f8f6f2] p-7">
            <h3 class="text-3xl">{group.title}</h3>
            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-2xl bg-white px-4 py-2 text-base leading-6 text-[#545454]">{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-center text-xl leading-9 text-[#545454]/85">Not sure where yours fits, or it doesn’t fit anywhere? That’s okay. Tell me a headline, or nothing at all.</p>
    </div>
  </section>

  <section class="border-b border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">Who it’s for</p>
        <h2 class="mt-4 text-5xl md:text-6xl">People come to me when they:</h2>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        {who.map((item) => (
          <article class="flex gap-4 border-t border-[#c4924a] bg-white p-6">
            <span class="mt-2 h-2.5 w-2.5 shrink-0 rounded-full bg-[#c4924a]" aria-hidden="true"></span>
            <p class="text-xl leading-8 text-[#545454]">{item}</p>
          </article>
        ))}
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-center text-2xl leading-snug text-[#545454]">You don’t need a big story or a diagnosis. You also don’t have to name what happened to you.</p>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto max-w-6xl">
      <p class="mx-auto max-w-3xl border-l border-[#c4924a] bg-[#f8f6f2] px-6 py-5 text-lg leading-8 text-[#545454]/85">
        <span class="text-[#545454]">A note up top:</span> I don’t diagnose, and I don’t provide psychotherapy. This work sits alongside medical and mental health care, not in place of it. If you have a therapist, I’m glad to work next to them.
      </p>
      <div class="prose mx-auto mt-12 max-w-6xl columns-1 gap-12 text-xl text-[#545454]/85 md:columns-2">
        <p><span class="text-[#545454]">Here’s the heart of it.</span> When stress hits, your nervous system ramps up. When the moment passes, it’s meant to come back down. Sometimes it stays ramped up instead.</p>
        <p>So we pay attention to the coming down. A breath comes easier. Muscles let go a little. Stress gets a bit easier to be with.</p>
        <p>Someone trained in Somatic Experiencing learns to notice when your system starts to ramp up, and to help it come down in small steps (SE calls this titration). That way your system can relearn how to settle on its own.</p>
        <p>Your nervous system may already come down sometimes, after a good talk or a walk, without you noticing. In SE, we slow down and notice it on purpose. When you can feel it happen, you can start to learn it.</p>
        <p>This is something you feel, not just think. It’s a different kind of knowing than talking about it. Many people say it helps them feel more connected to themselves again.</p>
        <p>Over time, many people find they remember what settling feels like. It becomes a pattern your system can find again, in daily life too. Nothing is guaranteed, but that’s what we practice.</p>
      </div>
    </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-start gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-5xl md:text-6xl">A picture that helps</h2>
        <div class="prose mt-6 text-xl text-[#545454]/85">
          <p>Think of a deer in a meadow. A twig snaps. The deer freezes, looks toward the sound, and its whole body gets ready to run. Then it sees a small bird on a dry leaf. The deer shakes, takes a few breaths, and goes back to grazing.</p>
          <p>People do the same thing, with one difference. We often don’t get to finish. We stay braced, even after the moment has passed.</p>
          <p class="text-2xl leading-snug text-[#545454]">Somatic Experiencing helps your nervous system notice it’s safe enough to come back down.</p>
        </div>
      </div>
      <div class="grid gap-6">
        <SessionPhoto
          src={deerSettled}
          alt="A deer standing at ease in dry grass, with oaks behind it"
          sizes="(min-width: 768px) 40vw, calc(100vw - 2.5rem)"
          class="aspect-[4/3] w-full rounded-[1.5rem] object-cover"
        />
        <figure class="mx-auto w-full max-w-[360px]">
          <video
            controls
            playsinline
            preload="none"
            poster="/video/se-deer-story-poster.jpg"
            class="aspect-[9/16] w-full rounded-[1.5rem] bg-[#545454]"
          >
            <source src="/video/se-deer-story-web.mp4" type="video/mp4" />
          </video>
          <figcaption class="mt-3 text-center text-sm leading-6 text-[#545454]/80">Ryan tells the deer story (1:28)</figcaption>
        </figure>
      </div>
    </div>

    <div class="mx-auto mt-16 grid max-w-6xl overflow-hidden rounded-[1.5rem] bg-[#545454] md:grid-cols-2">
      <div class="px-8 py-12 md:px-12 md:py-16">
        <h2 class="text-5xl text-white md:text-6xl">Try it anywhere.</h2>
        <div class="prose mt-6 text-xl text-white/85">
          <p>Slowly look around the room. Let your eyes land wherever they want. Notice what changes in you. Give it a minute or two.</p>
          <p>Did anything shift, even a little? Noticing it is the practice.</p>
        </div>
      </div>
      <SessionPhoto
        src={orientingBird}
        alt="A small bird perched on a bare branch against a soft sky"
        sizes="(min-width: 768px) 40vw, calc(100vw - 2.5rem)"
        class="aspect-[4/3] h-full w-full object-cover"
      />
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto max-w-6xl">
      <h2 class="text-center text-5xl md:text-6xl">What it’s like to work together</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {together.map((item) => (
          <article class="border-t border-[#c4924a] bg-[#f8f6f2] p-7">
            <h3 class="text-3xl">{item.title}</h3>
            <p class="mt-4 text-xl leading-8 text-[#545454]/85">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-start gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-5xl md:text-6xl">What you might notice</h2>
        <div class="prose mt-6 text-xl text-[#545454]/85">
          <p class="text-2xl leading-snug text-[#545454]">As your nervous system settles, many people notice some of these. Not everyone does, and nothing is guaranteed. You don’t have to feel any of them.</p>
          <p>A few honest notes. This isn’t a checklist or a test, and these signs can’t tell you what’s right or wrong with you. Calm and still isn’t always the same as settled, so we don’t try to look relaxed. A gentle shake can be a normal part of settling.</p>
          <p>Part of my training is learning to catch small changes you may not have noticed yet, so you can start to notice them too.</p>
          <p>The goal isn’t permanent calm. It’s a nervous system that gets better at coming back down on its own, with more room to move between the ups and the downs.</p>
        </div>
        <SessionPhoto
          src={oakLight}
          alt="Sunlight coming through the branches of a large oak"
          sizes="(min-width: 768px) 40vw, calc(100vw - 2.5rem)"
          class="mt-8 aspect-[4/3] w-full rounded-[1.5rem] object-cover"
        />
      </div>
      <ul class="border-t border-[#c4924a] bg-white p-7">
        {notices.map((item) => (
          <li class="border-b border-[#e8e1d7] py-4 text-xl leading-8 text-[#545454] last:border-b-0">{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="bg-white px-5 py-20">
    <div class="mx-auto max-w-3xl">
      <h2 class="text-center text-5xl md:text-6xl">Frequently asked questions</h2>
      <div class="mt-10 divide-y divide-[#e8e1d7] border-y border-[#e8e1d7]">
        {faqs.map((faq) => (
          <details class="group py-6">
            <summary class="cursor-pointer list-none text-2xl text-[#545454] marker:hidden">
              <span class="flex items-center justify-between gap-6">
                {faq.q}
                <span class="text-[#c4924a] transition group-open:rotate-45">+</span>
              </span>
            </summary>
            {faq.q.startsWith('What does it cost') ? (
              <div class="mt-4">
                <p class="text-lg leading-8 text-[#545454]/80">There are two session options:</p>
                <div class="mt-4 grid gap-3 sm:grid-cols-2">
                  <p class="rounded-2xl border border-[#e8e1d7] bg-[#f8f6f2] px-5 py-4 text-center">
                    <span class="block text-sm uppercase tracking-[0.16em] text-[#c4924a]">50 minutes</span>
                    <span class="mt-1 block font-display text-4xl text-[#545454]">$230</span>
                  </p>
                  <p class="rounded-2xl border border-[#e8e1d7] bg-[#f8f6f2] px-5 py-4 text-center">
                    <span class="block text-sm uppercase tracking-[0.16em] text-[#c4924a]">75 minutes</span>
                    <span class="mt-1 block font-display text-4xl text-[#545454]">$270</span>
                  </p>
                </div>
              </div>
            ) : (
              <p class="mt-4 text-lg leading-8 text-[#545454]/80">{faq.a}</p>
            )}
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20">
    <div class="mx-auto grid max-w-6xl items-center gap-10 overflow-hidden rounded-[1.5rem] border border-[#e8e1d7] bg-white md:grid-cols-[1.1fr_.9fr]">
      <div class="px-8 py-12 md:px-12">
        <h2 class="text-5xl md:text-6xl">Right here in Folsom</h2>
        <p class="mt-6 text-xl leading-9 text-[#545454]/85">My office is at 101 Parkshore Drive, Folsom, close to Lake Natoma and the American River Parkway. Easy to reach from El Dorado Hills, Cameron Park, Orangevale, and Roseville.</p>
        <a class="mt-6 inline-block rounded-xl bg-[#f8f6f2] px-4 py-3 text-[#545454] hover:text-[#c4924a]" href={mapsUrl}>101 Parkshore Drive, Folsom, CA 95630</a>
      </div>
      <SessionPhoto
        src={loneOak}
        alt="A lone oak standing in a green field under a blue sky"
        sizes="(min-width: 768px) 36vw, calc(100vw - 2.5rem)"
        class="aspect-[4/5] h-full w-full object-cover md:min-h-[420px]"
      />
    </div>
  </section>

  <section class="px-5 py-16">
    <div class="mx-auto max-w-4xl rounded-[1.5rem] bg-[#545454] px-8 py-16 text-center text-white md:px-16">
      <h2 class="text-5xl text-white md:text-6xl">Take it at your pace</h2>
      <p class="mx-auto mt-6 max-w-2xl text-xl leading-9 text-white/85">You don’t have to push through anything. If you’d like to know more first, send me a question. No pressure, and no need to have it figured out.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a class="rounded-full bg-[#c4924a] px-8 py-4 text-sm uppercase tracking-[0.18em] text-white transition hover:bg-[#9b7139]" href={bookUrl}>Book online</a>
        <a class="rounded-full border border-white/40 px-8 py-4 text-sm uppercase tracking-[0.18em] text-white transition hover:bg-white/10" href="/contact/">Ask Ryan a question</a>
      </div>
      <p class="mx-auto mt-10 max-w-3xl text-sm leading-7 text-white/70">Somatic Experiencing® is a wellness and nervous-system support approach. It’s not a substitute for medical care, psychotherapy, or emergency mental health support. Results vary.</p>
    </div>
  </section>
</Layout>
