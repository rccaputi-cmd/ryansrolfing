---
import Layout from '../layouts/Layout.astro';
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Rolfing for Scoliosis in Folsom",
    "description": "Rolfing Structural Integration in Folsom for tension, breath, and balance around a scoliosis curve. This work does not straighten a curve or replace medical care.",
    "provider": {
      "@id": "https://ryansrolfing.com/#business"
    },
    "areaServed": [
      "Folsom",
      "El Dorado Hills",
      "Shingle Springs",
      "Cameron Park",
      "Placerville",
      "Sacramento"
    ],
    "url": "https://ryansrolfing.com/rolfing-for-scoliosis-folsom/",
    "serviceType": "Rolfing Structural Integration"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can Rolfing fix scoliosis?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Rolfing does not straighten a structural curve. Some people find it useful for the tension, posture habits, and breath restrictions that sit around the curve. It is not medical care."
        }
      },
      {
        "@type": "Question",
        "name": "Is this safe if I have a fusion or a brace?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tell Ryan about hardware, fusion, and bracing before you book. Work stays off forcing a surgical area and can be adapted. Your surgeon or orthopedist is the right person for questions about the curve itself."
        }
      },
      {
        "@type": "Question",
        "name": "Will you try to make my spine look straight?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Sessions are about support, ease, and how the rest of the body relates to the curve. Chasing a visual correction usually adds more bracing."
        }
      },
      {
        "@type": "Question",
        "name": "When should I see a doctor first?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "New or changing curves, curves in children and teens, pain with fever or neurological symptoms, and any post-surgical concern belong with a physician. Rolfing is not a way to monitor scoliosis."
        }
      }
    ]
  }
];
