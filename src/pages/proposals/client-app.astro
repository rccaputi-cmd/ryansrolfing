---
import Layout from '../../layouts/Layout.astro';

const cards = [
  ['Prepare', 'What to know before your session: clothing, pacing, consent, and how to arrive with curiosity.'],
  ['Integrate', 'Gentle after-session guidance so your system can settle and reorganize without overthinking.'],
  ['Check in', 'A two-minute reflection to notice breath, support, movement, and what changed.'],
  ['Learn', 'Simple visual explanations of Rolfing, fascia, gravity, patterns, and nervous system support.'],
  ['Book', 'Quick access to booking, waitlist, contact, and review links.'],
  ['Series', 'Orientation for clients moving through a Rolfing series, one layer at a time.'],
];

const checkin = [
  'What feels easier right now?',
  'Where do you notice support?',
  'What feels different in your breath or movement?',
  'What would you like Ryan to know next session?',
];
---

<Layout title="Client App Concept | Ryan's Rolfing" description="A companion web app concept for Ryan's Rolfing clients.">
  <main class="bg-[var(--soft)]">
    <section class="mx-auto grid max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[1fr_420px] lg:items-center">
      <div>
        <p class="mb-4 text-sm uppercase tracking-[0.35em] text-[var(--gold-dark)]">App concept</p>
        <h1 class="font-display text-5xl leading-tight md:text-7xl">Ryan's Rolfing Companion</h1>
        <p class="mt-6 max-w-2xl text-xl leading-9">
          A calm, practical support app for clients before, after, and between sessions — built first as an installable web app inside Ryan's existing site.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#mockup" class="rounded-full bg-[var(--gold)] px-6 py-3 text-white shadow-sm">View mockup</a>
          <a href="#roadmap" class="rounded-full border border-[var(--gold)] px-6 py-3 text-[var(--gold-dark)]">Build roadmap</a>
        </div>
      </div>

      <div id="mockup" class="mx-auto w-full max-w-[390px] rounded-[2.5rem] border border-[var(--line)] bg-[#2e2e2e] p-3 shadow-2xl">
        <div class="rounded-[2rem] bg-white p-5">
          <div class="mb-5 flex items-center justify-between">
            <div>
              <p class="text-xs uppercase tracking-[0.25em] text-[var(--gold-dark)]">Welcome</p>
              <h2 class="font-display text-3xl">Companion</h2>
            </div>
            <div class="grid h-12 w-12 place-items-center rounded-full bg-[var(--soft)] text-xl text-[var(--gold-dark)]">↟</div>
          </div>

          <div class="rounded-3xl bg-[var(--soft)] p-4">
            <p class="text-sm uppercase tracking-[0.2em] text-[var(--gold-dark)]">Today</p>
            <p class="mt-2 text-lg leading-7">Take two minutes to notice what your body is organizing after your session.</p>
            <button class="mt-4 rounded-full bg-[var(--gold)] px-5 py-2 text-sm text-white">Start check-in</button>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3 text-sm">
            {cards.slice(0, 6).map(([title]) => (
              <div class="rounded-2xl border border-[var(--line)] p-3 text-center">
                <div class="mx-auto mb-2 h-8 w-8 rounded-full bg-[var(--soft)]"></div>
                <p>{title}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-12">
      <div class="mb-10 max-w-3xl">
        <p class="mb-3 text-sm uppercase tracking-[0.35em] text-[var(--gold-dark)]">MVP modules</p>
        <h2 class="font-display text-5xl">What the app would do first</h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {cards.map(([title, body]) => (
          <article class="rounded-[2rem] border border-[var(--line)] bg-white p-6 shadow-sm">
            <h3 class="font-display text-3xl">{title}</h3>
            <p class="mt-3 leading-8">{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-8 px-6 py-12 lg:grid-cols-2">
      <div class="rounded-[2rem] border border-[var(--line)] bg-white p-8">
        <p class="mb-3 text-sm uppercase tracking-[0.35em] text-[var(--gold-dark)]">Client support</p>
        <h2 class="font-display text-4xl">Two-minute body check-in</h2>
        <div class="mt-6 space-y-4">
          {checkin.map((q) => (
            <div class="rounded-2xl bg-[var(--soft)] p-4 leading-7">{q}</div>
          ))}
        </div>
      </div>

      <div class="rounded-[2rem] border border-[var(--line)] bg-white p-8">
        <p class="mb-3 text-sm uppercase tracking-[0.35em] text-[var(--gold-dark)]">Privacy-first</p>
        <h2 class="font-display text-4xl">Not a medical portal</h2>
        <p class="mt-5 leading-8">
          The first version should avoid logins, diagnoses, treatment records, or stored trauma history. It should support education, orientation, and integration — while sending anything personal back to direct communication with Ryan.
        </p>
        <ul class="mt-6 space-y-3 leading-7">
          <li>• No client-facing AI at launch</li>
          <li>• No sensitive cloud journaling at launch</li>
          <li>• Square booking links first, API later</li>
          <li>• Clear boundaries and emergency disclaimers</li>
        </ul>
      </div>
    </section>

    <section id="roadmap" class="mx-auto max-w-6xl px-6 py-12 pb-20">
      <div class="rounded-[2.5rem] bg-white p-8 shadow-sm">
        <p class="mb-3 text-sm uppercase tracking-[0.35em] text-[var(--gold-dark)]">Roadmap</p>
        <h2 class="font-display text-5xl">Build it in phases</h2>
        <div class="mt-8 grid gap-5 md:grid-cols-3">
          <div class="rounded-3xl bg-[var(--soft)] p-6">
            <h3 class="font-display text-3xl">30 days</h3>
            <p class="mt-3 leading-7">Hidden web-app preview with prep, integration, booking, review, and educational pages.</p>
          </div>
          <div class="rounded-3xl bg-[var(--soft)] p-6">
            <h3 class="font-display text-3xl">60 days</h3>
            <p class="mt-3 leading-7">Add body check-ins, series orientation, short audio practices, and treatment-room QR access.</p>
          </div>
          <div class="rounded-3xl bg-[var(--soft)] p-6">
            <h3 class="font-display text-3xl">90 days</h3>
            <p class="mt-3 leading-7">Connect Square read-only, refine lifecycle follow-ups, and decide whether accounts are worth it.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
