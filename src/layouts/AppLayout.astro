---
import '../styles/global.css';

const {
  title = "Ryan’s Rolfing Companion",
  description = "A simple companion app for Ryan’s Rolfing clients.",
  active = "home",
} = Astro.props;

const siteUrl = "https://ryansrolfing.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const nav = [
  ["/app", "Home", "⌂", "home"],
  ["/app/check-in", "Check in", "◌", "check"],
  ["/app/learn", "Learn", "✦", "learn"],
  ["/app/book", "Book", "↗", "book"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#f8f6f2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Rolfing Companion" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="manifest" href="/app.webmanifest" />
    <link rel="apple-touch-icon" href="/app-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Abel&family=Bellefair&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[var(--soft)]">
    <div class="mx-auto min-h-dvh max-w-[460px] bg-[var(--soft)] shadow-2xl md:my-4 md:min-h-[calc(100dvh-2rem)] md:overflow-hidden md:rounded-[2.25rem] md:border md:border-[var(--line)]">
      <header class="sticky top-0 z-40 border-b border-[var(--line)] bg-[var(--soft)]/95 px-5 pb-3 pt-[calc(env(safe-area-inset-top)+1rem)] backdrop-blur">
        <div class="flex items-center justify-between">
          <a href="/app" class="leading-none">
            <p class="text-[10px] uppercase tracking-[0.28em] text-[var(--gold-dark)]">Ryan’s Rolfing</p>
            <p class="font-display text-2xl">Companion</p>
          </a>
          <a href="/app/book" class="grid h-11 w-11 place-items-center rounded-full bg-white text-lg text-[var(--gold-dark)] shadow-sm" aria-label="Book or contact">↗</a>
        </div>
      </header>

      <main class="px-5 pb-[calc(env(safe-area-inset-bottom)+6.5rem)] pt-5">
        <slot />
      </main>

      <nav class="fixed inset-x-0 bottom-0 z-50 mx-auto max-w-[460px] border-t border-[var(--line)] bg-white/95 px-4 pb-[calc(env(safe-area-inset-bottom)+0.65rem)] pt-2 shadow-[0_-12px_30px_rgba(0,0,0,0.08)] backdrop-blur md:bottom-4 md:rounded-b-[2.25rem]" aria-label="App navigation">
        <div class="grid grid-cols-4 gap-1">
          {nav.map(([href, label, icon, key]) => (
            <a href={href} class:list={["rounded-2xl px-2 py-2 text-center text-xs transition", active === key ? "bg-[var(--soft)] text-[var(--gold-dark)]" : "text-[var(--gray)]"]}>
              <span class="block text-xl leading-5">{icon}</span>
              <span class="mt-1 block">{label}</span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </body>
</html>
