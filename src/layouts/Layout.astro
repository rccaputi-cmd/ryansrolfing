---
import '../styles/global.css';

const {
  title = "Ryan’s Rolfing | Folsom Structural Bodywork",
  description = "Rolfing and Somatic Experiencing in Folsom, CA with Ryan Caputi. Structural bodywork for pain, posture, movement, stress, and whole-person change.",
  image = "/images/hero-outdoor.jpg",
  schema = [],
} = Astro.props;

const siteUrl = "https://ryansrolfing.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HealthAndBeautyBusiness"],
  "@id": `${siteUrl}/#business`,
  name: "Ryan’s Rolfing",
  url: siteUrl,
  image: imageUrl,
  description,
  email: "info@ryansrolfing.com",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "101 Parkshore Drive",
    addressLocality: "Folsom",
    addressRegion: "CA",
    postalCode: "95630",
    addressCountry: "US",
  },
  areaServed: [
    "Folsom",
    "El Dorado Hills",
    "Shingle Springs",
    "Cameron Park",
    "Placerville",
    "El Dorado County",
    "Sacramento",
  ],
  knowsAbout: [
    "Rolfing Structural Integration",
    "Structural Integration",
    "Somatic Experiencing",
    "NeuroAffective Touch",
    "Trauma-informed bodywork",
    "Structural bodywork",
    "Jaw pain and TMJ tension",
    "Headache and migraine-related tension",
    "Neck pain",
    "Chronic pain",
    "Posture",
    "Fascia",
    "Embodiment",
    "Nervous system regulation",
    "Craniosacral Therapy",
  ],
  makesOffer: [
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Rolfing Structural Integration" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Rolfing for Jaw Pain and TMJ Tension" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Rolfing for Headaches and Migraines" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Rolfing for Neck Pain" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Rolfing Ten Series" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Somatic Experiencing" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "NeuroAffective Touch" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Craniosacral Therapy" } },
  ],
  sameAs: [
    "https://g.co/kgs/uVF626Q",
    "https://www.yelp.com/biz/ryans-rolfing-folsom",
  ],
};

const structuredData = [localBusinessSchema, ...(Array.isArray(schema) ? schema : [schema])];

const nav = [
  { href: "/", label: "Home" },
  {
    label: "Rolfing",
    children: [
      { href: "/method/", label: "Rolfing Method" },
      { href: "/rolfing-for-jaw-pain-tmj-folsom/", label: "Jaw Pain & TMJ Tension", short: "Jaw & TMJ" },
      { href: "/rolfing-for-headaches-migraines-folsom/", label: "Headaches & Migraines", short: "Headaches" },
      { href: "/rolfing-for-neck-pain-folsom/", label: "Neck Pain" },
    ],
  },
  {
    label: "Somatics",
    children: [
      { href: "/somatic-experiencing/", label: "Somatic Experiencing" },
      { href: "/craniosacral-therapy-folsom/", label: "Craniosacral Therapy", short: "Craniosacral" },
      { href: "/neuroaffective-touch/", label: "NeuroAffective Touch", short: "NATouch" },
    ],
  },
  { href: "/services/", label: "Services" },
  {
    label: "About",
    children: [
      { href: "/serving/", label: "Service Areas" },
      { href: "/blog/", label: "Articles" },
      { href: "/faq/", label: "FAQ" },
    ],
  },
  { href: "/contact/", label: "Contact" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ryan’s Rolfing" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Abel&family=Bellefair&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon-rr-20260524.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-rr-20260524-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-rr-20260524-16.png" />
    <link rel="shortcut icon" href="/favicon-rr-20260524-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-rr-20260524.png" />
  </head>
  <body>
    <div class="min-h-screen overflow-hidden">
      <header class="sticky top-0 z-50 border-b border-[#e8e1d7] bg-white/92 backdrop-blur">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4" aria-label="Main navigation">
          <a href="/" class="font-display text-2xl tracking-[0.16em] text-[#545454]">RYAN’S ROLFING</a>
          <div class="hidden items-center gap-7 text-sm uppercase tracking-[0.16em] text-[#545454] md:flex">
            {nav.map((item) => item.children ? (
              <div class="group relative py-2">
                <button class="flex items-center gap-1 uppercase tracking-[0.16em] transition hover:text-[#c4924a]" aria-haspopup="true" aria-expanded="false">
                  {item.label}
                  <span class="text-[0.7rem] leading-none">▾</span>
                </button>
                <div class="invisible absolute left-1/2 top-full w-64 -translate-x-1/2 rounded-2xl border border-[#e8e1d7] bg-white p-3 text-left opacity-0 shadow-xl transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                  {item.children.map((child) => (
                    <a class="block rounded-xl px-4 py-3 text-xs leading-5 tracking-[0.14em] transition hover:bg-[#f6f1ea] hover:text-[#c4924a]" href={child.href}>{child.label}</a>
                  ))}
                </div>
              </div>
            ) : (
              <a class="transition hover:text-[#c4924a]" href={item.href}>{item.label}</a>
            ))}
          </div>
          <a href="https://rolfing-106793.square.site" class="rounded-full bg-[#c4924a] px-5 py-2 text-sm uppercase tracking-[0.14em] text-white shadow-sm transition hover:bg-[#9b7139]">Book</a>
        </nav>
        <div class="border-t border-[#e8e1d7] px-5 py-3 md:hidden" aria-label="Mobile navigation">
          <div class="grid grid-cols-3 gap-2 text-xs uppercase tracking-[0.16em] text-[#545454]">
            {nav.map((item) => item.children ? (
              <details class="group relative rounded-xl px-2 py-2 text-center hover:bg-[#f6f1ea]">
                <summary class="list-none cursor-pointer hover:text-[#c4924a] marker:hidden">{item.label} ▾</summary>
                <div class="absolute left-0 right-0 top-full z-50 mt-2 rounded-2xl border border-[#e8e1d7] bg-white p-2 text-left shadow-xl">
                  {item.children.map((child) => (
                    <a class="block rounded-xl px-3 py-2 leading-5 hover:bg-[#f6f1ea] hover:text-[#c4924a]" href={child.href}>{child.short || child.label}</a>
                  ))}
                </div>
              </details>
            ) : (
              <a class="rounded-xl px-2 py-2 text-center hover:bg-[#f6f1ea] hover:text-[#c4924a]" href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="border-t border-[#e8e1d7] bg-[#545454] text-white">
        <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
          <div>
            <p class="font-display text-2xl tracking-[0.12em]">Ryan’s Rolfing</p>
            <p class="mt-3 max-w-md text-sm leading-7 text-white/75">Structural bodywork and nervous-system-informed care in Folsom, CA.</p>
          </div>
          <div class="text-sm leading-7 text-white/75">
            <p class="text-white">Visit</p>
            <a class="hover:text-white" href="https://www.google.com/maps/search/?api=1&query=101+Parkshore+Drive+Folsom+CA+95630">101 Parkshore Drive<br />Folsom, CA 95630</a>
          </div>
          <div class="text-sm leading-7 text-white/75">
            <p class="text-white">Connect</p>
            <a class="hover:text-white" href="mailto:info@ryansrolfing.com">info@ryansrolfing.com</a><br />
            <a class="hover:text-white" href="https://rolfing-106793.square.site">Book online</a><br />
            <a class="hover:text-white" href="/serving/folsom-rolfing/">Folsom</a> · <a class="hover:text-white" href="/blog/">Articles</a> · <a class="hover:text-white" href="/faq/">FAQ</a> · <a class="hover:text-white" href="/craniosacral-therapy-folsom/">Craniosacral</a> · <a class="hover:text-white" href="/testimonials/">Reviews</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
