---
import type { ImageMetadata } from 'astro';
import SessionPhoto from './SessionPhoto.astro';
import breath from '../assets/ten-series/01-breath-outer-legs.jpg';
import feet from '../assets/ten-series/02-feet-lower-legs.jpg';
import sideBody from '../assets/ten-series/03-side-body-balance.jpg';
import innerLeg from '../assets/ten-series/04-pelvic-floor-adductors.jpg';
import psoas from '../assets/ten-series/05-front-body-psoas.jpg';
import backBody from '../assets/ten-series/06-back-body-sacrum.jpg';
import headNeck from '../assets/ten-series/07-neck-cranium.jpg';

/**
 * Sessions 1–7 use the approved anatomy plates in src/assets (served as responsive WebP).
 * Sessions 8–10 stay on the previous public illustrations until those plates are approved.
 */
const intro = [
  "People invest heavily in homes, furniture, cars, and tools they use every day. The Ten-Series is an investment in the body you live in every moment — how you stand, breathe, move, recover, and feel yourself from the inside.",
  "Not every person needs to do the full Ten-Series. Some clients come in for specific goals, acute issues, or selected pieces of the work.",
  "But the Ten Series is the most complete way to experience Rolfing: a structured process for reorganizing the whole body over time. Each session has a purpose, and each step builds on the one before it.",
];

type Session = {
  number: string;
  title: string;
  body: string;
  alt: string;
  image?: ImageMetadata;
  src?: string;
  width?: number;
  height?: number;
};

const sessions: Session[] = [
  {
    number: "01",
    title: "Breath + outer legs",
    body: "Opening breath and beginning the body’s relationship to ground support.",
    alt: "Front view of the ribcage, showing the breastbone, the muscles between the ribs, the breathing muscle under the ribs, and neck muscles rising along the neck bones.",
    image: breath,
  },
  {
    number: "02",
    title: "Feet + lower legs",
    body: "Building a more adaptable foundation through the feet, ankles, and lower legs.",
    alt: "Outside view of a right foot and lower leg, showing the ankle and foot bones, the calf and shin muscles, and the tendons that run down to the toes.",
    image: feet,
  },
  {
    number: "03",
    title: "Side body balance",
    body: "Helping the front and back of the body relate through the side line.",
    alt: "Side view of the ribs, waist, hip and thigh, with a cutaway showing deep muscles beside the low spine and under the rim of the pelvis, the buttock muscles, and the pale band down the outer thigh.",
    image: sideBody,
  },
  {
    number: "04",
    title: "Pelvic floor + adductors",
    body: "Working with deep support through the inner legs and pelvic base.",
    alt: "Two views: at left, a hip and leg with the inner-thigh muscles, and without the pelvic floor, sacrum or low-back bones; at right, a half view of the pelvic floor, with the sacrum and low-back bones cut in section.",
    image: innerLeg,
  },
  {
    number: "05",
    title: "Front body + psoas",
    body: "Clarifying the deep front line that connects breath, pelvis, and legs.",
    alt: "Front view of the lower ribs, spine and pelvis, showing the psoas and iliacus, the deep muscles that run from the spine and the inside of the pelvis down to the thighs, and the front thigh muscles below.",
    image: psoas,
  },
  {
    number: "06",
    title: "Back body + sacrum",
    body: "Supporting the back line through the legs, sacrum, spine, and breath.",
    alt: "Back view of a standing skeleton, with the back and hamstring muscles shown on the right, yellow nerves running down the spine and both legs, and an inset of the pelvis highlighting the ligaments around the sacrum.",
    image: backBody,
  },
  {
    number: "07",
    title: "Neck + cranium",
    body: "Refining the relationship between the head, neck, jaw, and upper spine.",
    alt: "Painted side view of a skull and neck with the main skull bones in different colours, the seven neck vertebrae stacked under the skull base above the collarbone, and a round inset of the jaw joint.",
    image: headNeck,
  },
  {
    number: "08",
    title: "Pelvic girdle",
    body: "Integrating lower-body movement through the pelvis, legs, and spine.",
    alt: "Anatomical drawing of the pelvis, lumbar spine, and legs, with lines tracing support through the pelvic girdle",
    src: "/images/ten-series/08-pelvic-girdle.jpg",
    width: 1168,
    height: 880,
  },
  {
    number: "09",
    title: "Shoulder girdle",
    body: "Integrating upper-body support through the ribs, shoulders, arms, and neck.",
    alt: "Anatomical drawing of the rib cage, collarbones, shoulders, and arms",
    src: "/images/ten-series/09-shoulder-girdle.jpg",
    width: 1168,
    height: 880,
  },
  {
    number: "10",
    title: "Integration",
    body: "Bringing the whole body into a more coherent, connected pattern.",
    alt: "Anatomical drawing of a standing skeleton from head to feet, organized around a vertical line",
    src: "/images/ten-series/10-integration.jpg",
    width: 1168,
    height: 880,
  },
];

const imageSizes = "(min-width: 1024px) 220px, (min-width: 640px) 46vw, calc(100vw - 2.5rem)";
---

<section class="px-5 py-20" aria-labelledby="ten-series-heading">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-[0.28em] text-[#c4924a]">The Ten-Series</p>
    <h2 id="ten-series-heading" class="mt-4 text-5xl md:text-6xl">The classic Rolfing recipe.</h2>
    <div class="prose mx-auto mt-6 max-w-3xl text-xl text-[#545454]/85">
      {intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <div class="mx-auto mt-14 grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-5">
    {sessions.map((session) => (
      <article class="overflow-hidden rounded-[1.5rem] border border-[#e8e1d7] bg-white shadow-sm">
        {session.image ? (
          <SessionPhoto
            src={session.image}
            alt={session.alt}
            sizes={imageSizes}
            quality={90}
            class="aspect-[4/3] w-full bg-[#f4efe8] object-cover"
          />
        ) : (
          <img
            alt={session.alt}
            class="aspect-[4/3] w-full bg-[#f4efe8] object-cover"
            width={session.width}
            height={session.height}
            loading="lazy"
            decoding="async"
            src={session.src}
          />
        )}
        <div class="p-5">
          <p class="text-sm text-[#c4924a]">{session.number}</p>
          <h3 class="mt-2 text-2xl">{session.title}</h3>
          <p class="mt-3 text-base leading-7 text-[#545454]/80">{session.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>
