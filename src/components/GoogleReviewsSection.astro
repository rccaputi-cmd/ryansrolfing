---
import { googleReviews, homepageQuotes } from "../data/google-reviews";
import GoogleReviewCard from "./GoogleReviewCard.astro";
---

<section class="border-y border-[#e8e1d7] bg-[#f8f6f2] px-5 py-20" aria-labelledby="google-reviews-heading">
  <div class="mx-auto max-w-4xl text-center">
    <p class="text-sm uppercase tracking-[0.28em] text-[#8b642f]">Google reviews</p>
    <h2 id="google-reviews-heading" class="mt-4 text-5xl md:text-6xl">More from the Google listing.</h2>
  </div>
  <div class="mx-auto mt-14 grid max-w-6xl gap-6 md:grid-cols-3">
    {homepageQuotes.map((review) => <GoogleReviewCard quote={review.quote} attribution={review.attribution} />)}
  </div>
  <div class="mx-auto mt-10 flex max-w-4xl flex-col items-center justify-center gap-3 text-center sm:flex-row">
    <a
      href={googleReviews.url}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full border border-[#c4924a] px-6 py-3 text-sm uppercase tracking-[0.16em] text-[#545454] hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b642f]"
    >
      Read all {googleReviews.reviewCount} reviews on Google
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a
      href="https://www.yelp.com/biz/ryans-rolfing-folsom"
      class="rounded-full border border-[#c4924a] px-6 py-3 text-sm uppercase tracking-[0.16em] text-[#545454] hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#8b642f]"
    >
      Yelp reviews
    </a>
  </div>
</section>
